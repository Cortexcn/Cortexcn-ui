{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/next"],
  "files": {
    "includes": ["!!**/.agents"]
  },
  // The parent repo's pre-commit hook runs Prettier on these files, and
  // Prettier adds trailing commas everywhere. Matching it keeps the two
  // formatters from undoing each other.
  "javascript": {
    "formatter": { "trailingCommas": "all" }
  },
  "overrides": [
    {
      "includes": ["apps/web/public/r/**/*.json", "packages/ui/registry.json"],
      "formatter": { "enabled": false },
      "linter": { "enabled": false },
      "assist": { "enabled": false }
    },
    {
      // Static marketing/chart SVG exports — not hand-edited React components
      "includes": ["apps/web/public/**/*.svg"],
      "formatter": { "enabled": false },
      "linter": { "enabled": false },
      "assist": { "enabled": false }
    },
    {
      // Generated shadcn registry sources (registry:build); not hand-edited
      "includes": ["packages/ui/registry/**"],
      "formatter": { "enabled": false },
      "linter": { "enabled": false },
      "assist": { "enabled": false }
    },
    {
      // Allow barrel files for library exports - standard pattern for component libraries
      "includes": [
        "packages/ui/src/**/index.ts",
        "packages/ui/src/charts/line-chart.tsx",
        "packages/ui/src/charts/area-chart.tsx",
        "packages/ui/src/charts/scatter-chart.tsx"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      // Allow namespace imports for shadcn/ui components - standard pattern
      "includes": ["apps/web/components/ui/**"],
      "linter": {
        "rules": {
          "performance": {
            "noNamespaceImport": "off"
          }
        }
      }
    },
    {
      // Studio shadcn/ui primitives (base-nova) — same lint posture as apps/web
      "includes": ["packages/studio/src/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off",
            "noNoninteractiveElementInteractions": "off",
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off"
          },
          "performance": {
            "noNamespaceImport": "off"
          },
          "style": {
            "noNestedTernary": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      // shadcn/ui components and docs examples, vendored from the radix-vega
      // registry (see packages/ui/src/components/*.tsx headers). Same lint
      // posture as the other shadcn primitives in the repo.
      "includes": [
        "packages/ui/src/components/alert.tsx",
        "packages/ui/src/components/alert-dialog.tsx",
        "packages/ui/src/components/aspect-ratio.tsx",
        "packages/ui/src/components/avatar.tsx",
        "packages/ui/src/components/badge.tsx",
        "packages/ui/src/components/breadcrumb.tsx",
        "packages/ui/src/components/button.tsx",
        "packages/ui/src/components/button-group.tsx",
        "packages/ui/src/components/calendar.tsx",
        "packages/ui/src/components/carousel.tsx",
        "packages/ui/src/components/checkbox.tsx",
        "packages/ui/src/components/collapsible.tsx",
        "packages/ui/src/components/combobox.tsx",
        "packages/ui/src/components/command.tsx",
        "packages/ui/src/components/context-menu.tsx",
        "packages/ui/src/components/dialog.tsx",
        "packages/ui/src/components/drawer.tsx",
        "packages/ui/src/components/dropdown-menu.tsx",
        "packages/ui/src/components/empty.tsx",
        "packages/ui/src/components/field.tsx",
        "packages/ui/src/components/hover-card.tsx",
        "packages/ui/src/components/input.tsx",
        "packages/ui/src/components/input-group.tsx",
        "packages/ui/src/components/input-otp.tsx",
        "packages/ui/src/components/item.tsx",
        "packages/ui/src/components/kbd.tsx",
        "packages/ui/src/components/label.tsx",
        "packages/ui/src/components/menubar.tsx",
        "packages/ui/src/components/native-select.tsx",
        "packages/ui/src/components/navigation-menu.tsx",
        "packages/ui/src/components/pagination.tsx",
        "packages/ui/src/components/popover.tsx",
        "packages/ui/src/components/progress.tsx",
        "packages/ui/src/components/radio-group.tsx",
        "packages/ui/src/components/resizable.tsx",
        "packages/ui/src/components/scroll-area.tsx",
        "packages/ui/src/components/select.tsx",
        "packages/ui/src/components/separator.tsx",
        "packages/ui/src/components/sheet.tsx",
        "packages/ui/src/components/sidebar.tsx",
        "packages/ui/src/components/skeleton.tsx",
        "packages/ui/src/components/slider.tsx",
        "packages/ui/src/components/sonner.tsx",
        "packages/ui/src/components/spinner.tsx",
        "packages/ui/src/components/switch.tsx",
        "packages/ui/src/components/table.tsx",
        "packages/ui/src/components/tabs.tsx",
        "packages/ui/src/components/textarea.tsx",
        "packages/ui/src/components/toggle.tsx",
        "packages/ui/src/components/toggle-group.tsx",
        "packages/ui/src/components/tooltip.tsx",
        "packages/ui/src/examples/**",
        "packages/ui/src/hooks/use-mobile.ts"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveElementInteractions": "off",
            "noRedundantRoles": "off",
            "useAriaPropsForRole": "off",
            "useFocusableInteractive": "off",
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off",
            "useValidAnchor": "off"
          },
          "complexity": {
            "useSimplifiedLogicExpression": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off",
            "useImageSize": "off"
          },
          "performance": {
            "noNamespaceImport": "off"
          },
          "style": {
            "noNestedTernary": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noDocumentCookie": "off",
            "noDoubleEquals": "off",
            "noTemplateCurlyInString": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/icons/src/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      // Chart components have inherent complexity due to handling multiple configurations
      // (stacked/grouped, horizontal/vertical, multi-series, tooltips, animations)
      "includes": [
        "packages/ui/src/charts/bar-chart.tsx",
        "packages/ui/src/charts/bar.tsx"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    }
  ]
}
