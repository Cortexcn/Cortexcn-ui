{
  "id": "linear",
  "modes": {
    "light": {
      "background": "#ffffff",
      "foreground": "#000000",
      "card": "#f5f6f6",
      "card-foreground": "#000000",
      "popover": "#f5f6f6",
      "popover-foreground": "#000000",
      "primary": "#5e6ad2",
      "primary-foreground": "#ffffff",
      "secondary": "#f6f7f7",
      "secondary-foreground": "#000000",
      "muted": "#f6f7f7",
      "muted-foreground": "#565b64",
      "accent": "#f6f7f7",
      "accent-foreground": "#000000",
      "destructive": "#c13c37",
      "border": "#e4e4e4",
      "input": "#d7d7d7",
      "ring": "#5e6ad2",
      "chart-1": "#5e6ad2",
      "chart-2": "#007d29",
      "chart-3": "#8e9df4",
      "chart-4": "#2e3566",
      "chart-5": "#8e9df4",
      "primary-hover": "#4c55bb",
      "success": "#00892e",
      "warning": "#906b00",
      "overlay": "rgba(0, 0, 0, 0.4)"
    },
    "dark": {
      "background": "#010102",
      "foreground": "#f7f8f8",
      "card": "#0f1011",
      "card-foreground": "#f7f8f8",
      "popover": "#141516",
      "popover-foreground": "#f7f8f8",
      "primary": "#5e6ad2",
      "primary-foreground": "#ffffff",
      "secondary": "#0f1011",
      "secondary-foreground": "#f7f8f8",
      "muted": "#0f1011",
      "muted-foreground": "#d0d6e0",
      "accent": "#141516",
      "accent-foreground": "#f7f8f8",
      "destructive": "#f97066",
      "border": "#23252a",
      "input": "#34343a",
      "ring": "#5e69d1",
      "chart-1": "#5e6ad2",
      "chart-2": "#27a644",
      "chart-3": "#3d4593",
      "chart-4": "#b6c3ff",
      "chart-5": "#21226e",
      "primary-hover": "#828fff",
      "success": "#27a644",
      "warning": "#fbbf24",
      "overlay": "rgba(0, 0, 0, 0.6)"
    }
  },
  "typography": {
    "display": {
      "family": "Linear Display",
      "fallback": "Inter",
      "stack": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
    },
    "body": {
      "family": "Linear Text",
      "fallback": "Inter",
      "stack": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
    },
    "mono": {
      "family": "Linear Mono",
      "fallback": "JetBrains Mono",
      "stack": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": [12, 13, 14, 16, 18, 20, 22, 28, 40, 56, 80],
    "weights": {
      "regular": 400,
      "medium": 500,
      "bold": 600
    },
    "tracking": {
      "display": "-0.037em",
      "body": "-0.003em"
    },
    "lineHeight": {
      "display": 1.05,
      "body": 1.5
    }
  },
  "radius": {
    "none": "0px",
    "xs": "4px",
    "sm": "6px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "spacing": {
    "unit": 4,
    "density": "default"
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px 0 rgba(0, 0, 0, 0.06)",
    "2": "0 4px 12px -2px rgba(0, 0, 0, 0.12)",
    "3": "0 16px 32px -8px rgba(0, 0, 0, 0.24)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "components": {
    "button": {
      "radius": "md",
      "height": {
        "xs": 21,
        "sm": 29,
        "md": 33,
        "lg": 37
      },
      "paddingX": 14,
      "weight": "medium",
      "textTransform": "none",
      "tracking": "0",
      "shadow": "0"
    },
    "input": {
      "radius": "md",
      "height": 40,
      "paddingX": 12,
      "background": "card",
      "shadow": "0"
    },
    "card": {
      "radius": "lg",
      "padding": 24,
      "shadow": "0",
      "border": true,
      "background": "card"
    },
    "badge": {
      "radius": "full",
      "paddingX": 8,
      "weight": "regular",
      "textTransform": "none"
    },
    "tabs": {
      "radius": "full",
      "style": "segmented"
    },
    "accordion": {
      "dividers": true,
      "triggerWeight": "medium",
      "chevron": "rotate-180",
      "duration": "base",
      "paddingY": 16
    },
    "dialog": {
      "radius": "lg",
      "shadow": "3",
      "padding": 24
    },
    "menu": {
      "radius": "md",
      "itemRadius": "sm",
      "shadow": "2"
    },
    "control": {
      "radius": "xs"
    },
    "tooltip": {
      "radius": "sm"
    },
    "alert": {
      "radius": "lg"
    }
  }
}
