{
  "id": "framer",
  "modes": {
    "light": {
      "background": "#ffffff",
      "foreground": "#000000",
      "card": "#ffffff",
      "card-foreground": "#000000",
      "popover": "#ffffff",
      "popover-foreground": "#000000",
      "primary": "#161616",
      "primary-foreground": "#ffffff",
      "secondary": "#f5f5f5",
      "secondary-foreground": "#000000",
      "muted": "#f5f5f5",
      "muted-foreground": "#5b5b5b",
      "accent": "#f5f5f5",
      "accent-foreground": "#000000",
      "destructive": "#c13c37",
      "border": "#e4e4e4",
      "input": "#d7d7d7",
      "ring": "#161616",
      "chart-1": "#161616",
      "chart-2": "#0061a4",
      "chart-3": "#9300ac",
      "chart-4": "#755eff",
      "chart-5": "#833000",
      "primary-hover": "#292929",
      "success": "#00893c",
      "warning": "#906b00",
      "overlay": "rgba(0, 0, 0, 0.4)"
    },
    "dark": {
      "background": "#090909",
      "foreground": "#ffffff",
      "card": "#141414",
      "card-foreground": "#ffffff",
      "popover": "#1c1c1c",
      "popover-foreground": "#ffffff",
      "primary": "#ffffff",
      "primary-foreground": "#000000",
      "secondary": "#141414",
      "secondary-foreground": "#ffffff",
      "muted": "#141414",
      "muted-foreground": "#999999",
      "accent": "#1c1c1c",
      "accent-foreground": "#ffffff",
      "destructive": "#f97066",
      "border": "#262626",
      "input": "#262626",
      "ring": "#ffffff",
      "chart-1": "#ffffff",
      "chart-2": "#0099ff",
      "chart-3": "#d44df0",
      "chart-4": "#6a4cf5",
      "chart-5": "#ff7a3d",
      "primary-hover": "#e8e8e8",
      "success": "#22c55e",
      "warning": "#fbbf24",
      "overlay": "rgba(0, 0, 0, 0.6)"
    }
  },
  "typography": {
    "display": {
      "family": "GT Walsheim Framer Medium",
      "fallback": "Mona Sans",
      "stack": "\"Mona Sans\", ui-sans-serif, system-ui, sans-serif"
    },
    "body": {
      "family": "Inter Variable",
      "fallback": "Inter",
      "stack": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
    },
    "mono": {
      "family": "JetBrains Mono",
      "fallback": "JetBrains Mono",
      "stack": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": [12, 13, 14, 15, 18, 22, 24, 32, 62, 85, 110],
    "weights": {
      "regular": 400,
      "medium": 500,
      "bold": 500
    },
    "tracking": {
      "display": "-0.05em",
      "body": "-0.01em"
    },
    "lineHeight": {
      "display": 0.85,
      "body": 1.3
    }
  },
  "radius": {
    "none": "0px",
    "xs": "4px",
    "sm": "6px",
    "md": "10px",
    "lg": "15px",
    "xl": "20px",
    "full": "9999px"
  },
  "spacing": {
    "unit": 4,
    "density": "default"
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px 0 rgba(0, 0, 0, 0.06)",
    "2": "0 4px 12px -2px rgba(0, 0, 0, 0.12)",
    "3": "0 16px 32px -8px rgba(0, 0, 0, 0.24)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "components": {
    "button": {
      "radius": "full",
      "height": {
        "xs": 22,
        "sm": 30,
        "md": 34,
        "lg": 38
      },
      "paddingX": 15,
      "weight": "medium",
      "textTransform": "none",
      "tracking": "-0.01em",
      "shadow": "0"
    },
    "input": {
      "radius": "md",
      "height": 40,
      "paddingX": 14,
      "background": "card",
      "shadow": "0"
    },
    "card": {
      "radius": "lg",
      "padding": 12,
      "shadow": "0",
      "border": false,
      "background": "card"
    },
    "badge": {
      "radius": "full",
      "paddingX": 8,
      "weight": "medium",
      "textTransform": "none"
    },
    "tabs": {
      "radius": "full",
      "style": "segmented"
    },
    "accordion": {
      "dividers": true,
      "triggerWeight": "regular",
      "chevron": "rotate-180",
      "duration": "base",
      "paddingY": 24
    },
    "dialog": {
      "radius": "lg",
      "shadow": "3",
      "padding": 24
    },
    "menu": {
      "radius": "md",
      "itemRadius": "sm",
      "shadow": "2"
    },
    "control": {
      "radius": "xs"
    },
    "tooltip": {
      "radius": "sm"
    },
    "alert": {
      "radius": "lg"
    }
  }
}
