{
  "id": "zapier",
  "modes": {
    "light": {
      "background": "#fffefb",
      "foreground": "#201515",
      "card": "#fffefb",
      "card-foreground": "#201515",
      "popover": "#fffefb",
      "popover-foreground": "#201515",
      "primary": "#ff4f00",
      "primary-foreground": "#fffefb",
      "secondary": "#f8f4f0",
      "secondary-foreground": "#201515",
      "muted": "#f8f4f0",
      "muted-foreground": "#605d52",
      "accent": "#f8f4f0",
      "accent-foreground": "#201515",
      "destructive": "#d92d20",
      "border": "#deddda",
      "input": "#deddda",
      "ring": "#ff4f00",
      "chart-1": "#ff4f00",
      "chart-2": "#ffa78d",
      "chart-3": "#bb3700",
      "chart-4": "#ffe0d7",
      "chart-5": "#842400",
      "primary-hover": "#dc4300",
      "success": "#15803d",
      "warning": "#b45309",
      "overlay": "rgba(0, 0, 0, 0.4)"
    },
    "dark": {
      "background": "#100f0d",
      "foreground": "#feeded",
      "card": "#181715",
      "card-foreground": "#feeded",
      "popover": "#1e1c1a",
      "popover-foreground": "#feeded",
      "primary": "#ff4f00",
      "primary-foreground": "#100f0d",
      "secondary": "#252421",
      "secondary-foreground": "#feeded",
      "muted": "#252421",
      "muted-foreground": "#a8a599",
      "accent": "#252421",
      "accent-foreground": "#feeded",
      "destructive": "#ff5543",
      "border": "#2e2d2b",
      "input": "#393735",
      "ring": "#ff4f00",
      "chart-1": "#ff4f00",
      "chart-2": "#a85840",
      "chart-3": "#fe764d",
      "chart-4": "#856a63",
      "chart-5": "#ffb6a1",
      "primary-hover": "#dc4300",
      "success": "#50af69",
      "warning": "#de793d",
      "overlay": "rgba(0, 0, 0, 0.6)"
    }
  },
  "typography": {
    "display": {
      "family": "Degular Display",
      "fallback": "Mona Sans",
      "stack": "\"Mona Sans\", ui-sans-serif, system-ui, sans-serif"
    },
    "body": {
      "family": "Inter",
      "fallback": "Inter",
      "stack": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
    },
    "mono": {
      "family": "JetBrains Mono",
      "fallback": "JetBrains Mono",
      "stack": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": [14, 14.4, 16, 18, 20, 24, 32, 48, 56],
    "weights": {
      "regular": 400,
      "medium": 600,
      "bold": 500
    },
    "tracking": {
      "display": "0",
      "body": "0"
    },
    "lineHeight": {
      "display": 1,
      "body": 1.5
    }
  },
  "radius": {
    "none": "0px",
    "xs": "3px",
    "sm": "6px",
    "md": "12px",
    "lg": "18px",
    "xl": "24px",
    "full": "9999px"
  },
  "spacing": {
    "unit": 2,
    "density": "default"
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px 0 rgba(0, 0, 0, 0.06)",
    "2": "0 4px 12px -2px rgba(0, 0, 0, 0.12)",
    "3": "0 16px 32px -8px rgba(0, 0, 0, 0.24)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "components": {
    "button": {
      "radius": "md",
      "height": {
        "xs": 31,
        "sm": 39,
        "md": 43,
        "lg": 47
      },
      "paddingX": 16,
      "weight": "medium",
      "textTransform": "none",
      "tracking": "0",
      "shadow": "0"
    },
    "input": {
      "radius": "sm",
      "height": 43,
      "paddingX": 12,
      "background": "transparent",
      "shadow": "0"
    },
    "card": {
      "radius": "md",
      "padding": 24,
      "shadow": "0",
      "border": true,
      "background": "muted"
    },
    "badge": {
      "radius": "full",
      "paddingX": 8,
      "weight": "regular",
      "textTransform": "none"
    },
    "tabs": {
      "radius": "md",
      "style": "segmented"
    },
    "accordion": {
      "dividers": true,
      "triggerWeight": "medium",
      "chevron": "rotate-180",
      "duration": "base",
      "paddingY": 16
    },
    "dialog": {
      "radius": "md",
      "shadow": "3",
      "padding": 24
    },
    "menu": {
      "radius": "sm",
      "itemRadius": "xs",
      "shadow": "2"
    },
    "control": {
      "radius": "xs"
    },
    "tooltip": {
      "radius": "sm"
    },
    "alert": {
      "radius": "md"
    }
  }
}
