{
  "id": "sanity",
  "modes": {
    "light": {
      "background": "#ffffff",
      "foreground": "#0b0b0b",
      "card": "#ffffff",
      "card-foreground": "#0b0b0b",
      "popover": "#ffffff",
      "popover-foreground": "#0b0b0b",
      "primary": "#0b0b0b",
      "primary-foreground": "#ffffff",
      "secondary": "#ededed",
      "secondary-foreground": "#0b0b0b",
      "muted": "#ededed",
      "muted-foreground": "#3c4758",
      "accent": "#ededed",
      "accent-foreground": "#0b0b0b",
      "destructive": "#d60000",
      "border": "#ededed",
      "input": "#d7d7d7",
      "ring": "#0b0b0b",
      "chart-1": "#0b0b0b",
      "chart-2": "#a81617",
      "chart-3": "#4784ff",
      "chart-4": "#005531",
      "chart-5": "#958589",
      "primary-hover": "#1d1d1d",
      "success": "#008751",
      "warning": "#906b00",
      "overlay": "rgba(0, 0, 0, 0.4)"
    },
    "dark": {
      "background": "#0b0b0b",
      "foreground": "#ffffff",
      "card": "#212121",
      "card-foreground": "#ffffff",
      "popover": "#212121",
      "popover-foreground": "#ffffff",
      "primary": "#ffffff",
      "primary-foreground": "#0b0b0b",
      "secondary": "#212121",
      "secondary-foreground": "#ffffff",
      "muted": "#212121",
      "muted-foreground": "#b9b9b9",
      "accent": "#212121",
      "accent-foreground": "#ffffff",
      "destructive": "#dd0000",
      "border": "#353535",
      "input": "#353535",
      "ring": "#ffffff",
      "chart-1": "#ffffff",
      "chart-2": "#f36458",
      "chart-3": "#0052ef",
      "chart-4": "#37cd84",
      "chart-5": "#736468",
      "primary-hover": "#e8e8e8",
      "success": "#37cd84",
      "warning": "#fbbf24",
      "overlay": "rgba(0, 0, 0, 0.6)"
    }
  },
  "typography": {
    "display": {
      "family": "waldenburgNormal",
      "fallback": "Inter",
      "stack": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
    },
    "body": {
      "family": "waldenburgNormal",
      "fallback": "Inter",
      "stack": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
    },
    "mono": {
      "family": "ibmPlexMono",
      "fallback": "IBM Plex Mono",
      "stack": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": [10, 11, 12, 13, 15, 16, 18, 24, 32, 38, 48, 60, 72, 112],
    "weights": {
      "regular": 400,
      "medium": 500,
      "bold": 400
    },
    "tracking": {
      "display": "-0.04em",
      "body": "0"
    },
    "lineHeight": {
      "display": 1,
      "body": 1.5
    }
  },
  "radius": {
    "none": "0px",
    "xs": "3px",
    "sm": "4px",
    "md": "5px",
    "lg": "6px",
    "xl": "12px",
    "full": "99999px"
  },
  "spacing": {
    "unit": 4,
    "density": "comfortable"
  },
  "elevation": {
    "0": "none",
    "1": "0 4px 24px rgba(0,0,0,0.08)",
    "2": "0 4px 12px -2px rgba(0, 0, 0, 0.12)",
    "3": "0 16px 32px -8px rgba(0, 0, 0, 0.24)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "components": {
    "button": {
      "radius": "full",
      "height": {
        "xs": 32,
        "sm": 40,
        "md": 44,
        "lg": 48
      },
      "paddingX": 12,
      "weight": "medium",
      "textTransform": "none",
      "tracking": "0",
      "shadow": "0"
    },
    "input": {
      "radius": "xs",
      "height": 44,
      "paddingX": 12,
      "background": "transparent",
      "shadow": "0"
    },
    "card": {
      "radius": "xl",
      "padding": 32,
      "shadow": "0",
      "border": false,
      "background": "card"
    },
    "badge": {
      "radius": "full",
      "paddingX": 8,
      "weight": "regular",
      "textTransform": "none"
    },
    "tabs": {
      "radius": "sm",
      "style": "segmented"
    },
    "accordion": {
      "dividers": true,
      "triggerWeight": "medium",
      "chevron": "rotate-180",
      "duration": "base",
      "paddingY": 16
    },
    "dialog": {
      "radius": "xl",
      "shadow": "3",
      "padding": 24
    },
    "menu": {
      "radius": "lg",
      "itemRadius": "md",
      "shadow": "2"
    },
    "control": {
      "radius": "xs"
    },
    "tooltip": {
      "radius": "sm"
    },
    "alert": {
      "radius": "xl"
    }
  }
}
