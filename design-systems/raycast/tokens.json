{
  "id": "raycast",
  "modes": {
    "light": {
      "background": "#f8fafe",
      "foreground": "#111113",
      "card": "#ffffff",
      "card-foreground": "#111113",
      "popover": "#ffffff",
      "popover-foreground": "#111113",
      "primary": "#161616",
      "primary-foreground": "#f8fafe",
      "secondary": "#eef0f4",
      "secondary-foreground": "#111113",
      "muted": "#eef0f4",
      "muted-foreground": "#5b5b5b",
      "accent": "#eef0f4",
      "accent-foreground": "#111113",
      "destructive": "#ca2c36",
      "border": "#dedfe3",
      "input": "#d0d2d6",
      "ring": "#161616",
      "chart-1": "#161616",
      "chart-2": "#004768",
      "chart-3": "#004b2e",
      "chart-4": "#4c3700",
      "chart-5": "#958589",
      "primary-hover": "#292929",
      "success": "#008757",
      "warning": "#906b00",
      "overlay": "rgba(0, 0, 0, 0.4)"
    },
    "dark": {
      "background": "#07080a",
      "foreground": "#f4f4f6",
      "card": "#121212",
      "card-foreground": "#f4f4f6",
      "popover": "#101111",
      "popover-foreground": "#f4f4f6",
      "primary": "#ffffff",
      "primary-foreground": "#000000",
      "secondary": "#0d0d0d",
      "secondary-foreground": "#f4f4f6",
      "muted": "#0d0d0d",
      "muted-foreground": "#cdcdcd",
      "accent": "#101111",
      "accent-foreground": "#f4f4f6",
      "destructive": "#ff6161",
      "border": "#242728",
      "input": "rgba(255,255,255,0.16)",
      "ring": "#ffffff",
      "chart-1": "#ffffff",
      "chart-2": "#57c1ff",
      "chart-3": "#59d499",
      "chart-4": "#ffc533",
      "chart-5": "#736468",
      "primary-hover": "#e8e8e8",
      "success": "#59d499",
      "warning": "#ffc533",
      "overlay": "rgba(0, 0, 0, 0.6)"
    }
  },
  "typography": {
    "display": {
      "family": "Inter",
      "fallback": "Inter",
      "stack": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
    },
    "body": {
      "family": "Inter",
      "fallback": "Inter",
      "stack": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
    },
    "mono": {
      "family": "JetBrains Mono",
      "fallback": "JetBrains Mono",
      "stack": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": [12, 13, 14, 16, 18, 20, 22, 24, 56, 64],
    "weights": {
      "regular": 400,
      "medium": 500,
      "bold": 600
    },
    "tracking": {
      "display": "0",
      "body": "0"
    },
    "lineHeight": {
      "display": 1.1,
      "body": 1.6
    }
  },
  "radius": {
    "none": "0px",
    "xs": "4px",
    "sm": "6px",
    "md": "8px",
    "lg": "10px",
    "xl": "16px",
    "full": "9999px"
  },
  "spacing": {
    "unit": 2,
    "density": "default"
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px 0 rgba(0, 0, 0, 0.06)",
    "2": "0 4px 12px -2px rgba(0, 0, 0, 0.12)",
    "3": "0 16px 32px -8px rgba(0, 0, 0, 0.24)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "components": {
    "button": {
      "radius": "md",
      "height": {
        "xs": 24,
        "sm": 32,
        "md": 36,
        "lg": 40
      },
      "paddingX": 16,
      "weight": "medium",
      "textTransform": "none",
      "tracking": "0.014em",
      "shadow": "0"
    },
    "input": {
      "radius": "md",
      "height": 36,
      "paddingX": 12,
      "background": "transparent",
      "shadow": "0"
    },
    "card": {
      "radius": "lg",
      "padding": 24,
      "shadow": "0",
      "border": false,
      "background": "muted"
    },
    "badge": {
      "radius": "xs",
      "paddingX": 6,
      "weight": "regular",
      "textTransform": "none"
    },
    "tabs": {
      "radius": "full",
      "style": "segmented"
    },
    "accordion": {
      "dividers": true,
      "triggerWeight": "medium",
      "chevron": "rotate-180",
      "duration": "base",
      "paddingY": 16
    },
    "dialog": {
      "radius": "lg",
      "shadow": "3",
      "padding": 24
    },
    "menu": {
      "radius": "md",
      "itemRadius": "sm",
      "shadow": "2"
    },
    "control": {
      "radius": "xs"
    },
    "tooltip": {
      "radius": "sm"
    },
    "alert": {
      "radius": "lg"
    }
  }
}
