{
  "id": "sentry",
  "modes": {
    "light": {
      "background": "#ffffff",
      "foreground": "#1f1633",
      "card": "#ffffff",
      "card-foreground": "#1f1633",
      "popover": "#ffffff",
      "popover-foreground": "#1f1633",
      "primary": "#150f23",
      "primary-foreground": "#ffffff",
      "secondary": "#f0f0f0",
      "secondary-foreground": "#1f1633",
      "muted": "#f0f0f0",
      "muted-foreground": "#5d5960",
      "accent": "#f0f0f0",
      "accent-foreground": "#1f1633",
      "destructive": "#c13c37",
      "border": "#e5e7eb",
      "input": "#d7d7d7",
      "ring": "#150f23",
      "chart-1": "#150f23",
      "chart-2": "#314100",
      "chart-3": "#7b72d6",
      "chart-4": "#716266",
      "chart-5": "#958589",
      "primary-hover": "#282237",
      "success": "#008843",
      "warning": "#906b00",
      "overlay": "rgba(0, 0, 0, 0.4)"
    },
    "dark": {
      "background": "#1f1633",
      "foreground": "#ffffff",
      "card": "#150f23",
      "card-foreground": "#ffffff",
      "popover": "#150f23",
      "popover-foreground": "#ffffff",
      "primary": "#ffffff",
      "primary-foreground": "#1f1633",
      "secondary": "#2d2543",
      "secondary-foreground": "#ffffff",
      "muted": "#2d2543",
      "muted-foreground": "#bdb8c0",
      "accent": "#2d2543",
      "accent-foreground": "#ffffff",
      "destructive": "#f97066",
      "border": "#362d59",
      "input": "#362d59",
      "ring": "#9dc1f5",
      "chart-1": "#ffffff",
      "chart-2": "#c2ef4e",
      "chart-3": "#6a5fc1",
      "chart-4": "#97878b",
      "chart-5": "#736468",
      "primary-hover": "#e8e8e8",
      "success": "#4ade80",
      "warning": "#fbbf24",
      "overlay": "rgba(0, 0, 0, 0.6)"
    }
  },
  "typography": {
    "display": {
      "family": "Sentry Display",
      "fallback": "Space Grotesk",
      "stack": "\"Space Grotesk\", ui-sans-serif, system-ui, sans-serif"
    },
    "body": {
      "family": "Rubik",
      "fallback": "Rubik",
      "stack": "\"Rubik\", ui-sans-serif, system-ui, sans-serif"
    },
    "mono": {
      "family": "Monaco",
      "fallback": "Ubuntu Mono",
      "stack": "\"Ubuntu Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": [10, 14, 15, 16, 20, 24, 27, 30, 60, 88],
    "weights": {
      "regular": 500,
      "medium": 700,
      "bold": 700
    },
    "tracking": {
      "display": "0",
      "body": "0"
    },
    "lineHeight": {
      "display": 1.2,
      "body": 1.5
    }
  },
  "radius": {
    "none": "0px",
    "xs": "4px",
    "sm": "6px",
    "md": "8px",
    "lg": "10px",
    "xl": "12px",
    "full": "9999px"
  },
  "spacing": {
    "unit": 2,
    "density": "default"
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px 0 rgba(0, 0, 0, 0.06)",
    "2": "0 4px 12px -2px rgba(0, 0, 0, 0.12)",
    "3": "0 16px 32px -8px rgba(0, 0, 0, 0.24)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "components": {
    "button": {
      "radius": "md",
      "height": {
        "xs": 28,
        "sm": 36,
        "md": 40,
        "lg": 44
      },
      "paddingX": 16,
      "weight": "medium",
      "textTransform": "uppercase",
      "tracking": "0.014em",
      "shadow": "0"
    },
    "input": {
      "radius": "sm",
      "height": 40,
      "paddingX": 12,
      "background": "transparent",
      "shadow": "0"
    },
    "card": {
      "radius": "xl",
      "padding": 32,
      "shadow": "0",
      "border": true,
      "background": "background"
    },
    "badge": {
      "radius": "xs",
      "paddingX": 12,
      "weight": "medium",
      "textTransform": "none"
    },
    "tabs": {
      "radius": "md",
      "style": "segmented"
    },
    "accordion": {
      "dividers": true,
      "triggerWeight": "medium",
      "chevron": "rotate-180",
      "duration": "base",
      "paddingY": 16
    },
    "dialog": {
      "radius": "xl",
      "shadow": "3",
      "padding": 24
    },
    "menu": {
      "radius": "lg",
      "itemRadius": "md",
      "shadow": "2"
    },
    "control": {
      "radius": "xs"
    },
    "tooltip": {
      "radius": "sm"
    },
    "alert": {
      "radius": "xl"
    }
  }
}
