{
  "id": "resend",
  "modes": {
    "light": {
      "background": "#f1f7fe",
      "foreground": "#000000",
      "card": "#ffffff",
      "card-foreground": "#000000",
      "popover": "#ffffff",
      "popover-foreground": "#000000",
      "primary": "#151617",
      "primary-foreground": "#f1f7fe",
      "secondary": "#e7edf4",
      "secondary-foreground": "#000000",
      "muted": "#e7edf4",
      "muted-foreground": "rgba(0,0,51,0.7)",
      "accent": "#e7edf4",
      "accent-foreground": "#000000",
      "destructive": "#d40035",
      "border": "#d7dde3",
      "input": "#cad0d6",
      "ring": "#151617",
      "chart-1": "#151617",
      "chart-2": "#793700",
      "chart-3": "#4c3700",
      "chart-4": "#004727",
      "chart-5": "#bf002e",
      "primary-hover": "#28292a",
      "success": "#00884e",
      "warning": "#906b00",
      "overlay": "rgba(0, 0, 0, 0.4)"
    },
    "dark": {
      "background": "#000000",
      "foreground": "#fcfdff",
      "card": "#0a0a0c",
      "card-foreground": "#fcfdff",
      "popover": "#101012",
      "popover-foreground": "#fcfdff",
      "primary": "#fcfdff",
      "primary-foreground": "#000000",
      "secondary": "#101012",
      "secondary-foreground": "#fcfdff",
      "muted": "#101012",
      "muted-foreground": "rgba(252,253,255,0.86)",
      "accent": "#101012",
      "accent-foreground": "#fcfdff",
      "destructive": "#ff2047",
      "border": "rgba(255,255,255,0.06)",
      "input": "rgba(255,255,255,0.14)",
      "ring": "#fcfdff",
      "chart-1": "#fcfdff",
      "chart-2": "#ff801f",
      "chart-3": "#ffc53d",
      "chart-4": "#11ff99",
      "chart-5": "#ff2047",
      "primary-hover": "#e5e6e8",
      "success": "#11ff99",
      "warning": "#ffc53d",
      "overlay": "rgba(0, 0, 0, 0.6)"
    }
  },
  "typography": {
    "display": {
      "family": "Domaine Display",
      "fallback": "Instrument Serif",
      "stack": "\"Instrument Serif\", ui-serif, Georgia, serif"
    },
    "body": {
      "family": "ABC Favorit",
      "fallback": "Inter",
      "stack": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
    },
    "mono": {
      "family": "Geist Mono",
      "fallback": "Geist Mono",
      "stack": "\"Geist Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": [12, 13, 14, 16, 18, 20, 24, 56, 76.8, 96],
    "weights": {
      "regular": 400,
      "medium": 500,
      "bold": 400
    },
    "tracking": {
      "display": "-0.01em",
      "body": "-0.05em"
    },
    "lineHeight": {
      "display": 1,
      "body": 1.5
    }
  },
  "radius": {
    "none": "0px",
    "xs": "4px",
    "sm": "6px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "spacing": {
    "unit": 2,
    "density": "default"
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px 0 rgba(0, 0, 0, 0.06)",
    "2": "0 4px 12px -2px rgba(0, 0, 0, 0.12)",
    "3": "0 16px 32px -8px rgba(0, 0, 0, 0.24)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "components": {
    "button": {
      "radius": "md",
      "height": {
        "xs": 24,
        "sm": 32,
        "md": 36,
        "lg": 40
      },
      "paddingX": 16,
      "weight": "medium",
      "textTransform": "none",
      "tracking": "0",
      "shadow": "0"
    },
    "input": {
      "radius": "md",
      "height": 40,
      "paddingX": 14,
      "background": "card",
      "shadow": "0"
    },
    "card": {
      "radius": "lg",
      "padding": 32,
      "shadow": "0",
      "border": false,
      "background": "card"
    },
    "badge": {
      "radius": "full",
      "paddingX": 10,
      "weight": "regular",
      "textTransform": "none"
    },
    "tabs": {
      "radius": "sm",
      "style": "segmented"
    },
    "accordion": {
      "dividers": true,
      "triggerWeight": "medium",
      "chevron": "rotate-180",
      "duration": "base",
      "paddingY": 16
    },
    "dialog": {
      "radius": "lg",
      "shadow": "3",
      "padding": 24
    },
    "menu": {
      "radius": "md",
      "itemRadius": "sm",
      "shadow": "2"
    },
    "control": {
      "radius": "xs"
    },
    "tooltip": {
      "radius": "sm"
    },
    "alert": {
      "radius": "lg"
    }
  }
}
