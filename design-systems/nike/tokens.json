{
  "id": "nike",
  "modes": {
    "light": {
      "background": "#ffffff",
      "foreground": "#111111",
      "card": "#ffffff",
      "card-foreground": "#111111",
      "popover": "#ffffff",
      "popover-foreground": "#111111",
      "primary": "#111111",
      "primary-foreground": "#ffffff",
      "secondary": "#f5f5f5",
      "secondary-foreground": "#111111",
      "muted": "#f5f5f5",
      "muted-foreground": "#39393b",
      "accent": "#f5f5f5",
      "accent-foreground": "#111111",
      "destructive": "#d30005",
      "border": "#cacacb",
      "input": "#cacacb",
      "ring": "#111111",
      "chart-1": "#111111",
      "chart-2": "#007d48",
      "chart-3": "#0a7281",
      "chart-4": "#79696d",
      "chart-5": "#9d8d91",
      "primary-hover": "#232323",
      "success": "#007d48",
      "warning": "#b45309",
      "overlay": "rgba(0, 0, 0, 0.4)"
    },
    "dark": {
      "background": "#0f0f0f",
      "foreground": "#f2f2f2",
      "card": "#171717",
      "card-foreground": "#f2f2f2",
      "popover": "#1c1c1c",
      "popover-foreground": "#f2f2f2",
      "primary": "#ebebeb",
      "primary-foreground": "#0f0f0f",
      "secondary": "#242424",
      "secondary-foreground": "#f2f2f2",
      "muted": "#242424",
      "muted-foreground": "#a4a4a7",
      "accent": "#242424",
      "accent-foreground": "#f2f2f2",
      "destructive": "#ff5546",
      "border": "#2d2d2d",
      "input": "#373737",
      "ring": "#ebebeb",
      "chart-1": "#ebebeb",
      "chart-2": "#5dc086",
      "chart-3": "#65bbca",
      "chart-4": "#ae9da1",
      "chart-5": "#88797d",
      "primary-hover": "#d4d4d4",
      "success": "#4caf77",
      "warning": "#de793d",
      "overlay": "rgba(0, 0, 0, 0.6)"
    }
  },
  "typography": {
    "display": {
      "family": "Nike Futura ND",
      "fallback": "Bebas Neue",
      "stack": "\"Bebas Neue\", ui-sans-serif, system-ui, sans-serif"
    },
    "body": {
      "family": "Helvetica Now Text",
      "fallback": "Inter",
      "stack": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
    },
    "mono": {
      "family": "JetBrains Mono",
      "fallback": "JetBrains Mono",
      "stack": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": [9, 12, 14, 16, 24, 32, 96],
    "weights": {
      "regular": 400,
      "medium": 500,
      "bold": 500
    },
    "tracking": {
      "display": "0",
      "body": "0"
    },
    "lineHeight": {
      "display": 0.9,
      "body": 1.5
    }
  },
  "radius": {
    "none": "0px",
    "xs": "9px",
    "sm": "18px",
    "md": "24px",
    "lg": "30px",
    "xl": "40px",
    "full": "9999px"
  },
  "spacing": {
    "unit": 2,
    "density": "comfortable"
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px 0 rgba(0, 0, 0, 0.06)",
    "2": "0 4px 12px -2px rgba(0, 0, 0, 0.12)",
    "3": "0 16px 32px -8px rgba(0, 0, 0, 0.24)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "components": {
    "button": {
      "radius": "full",
      "height": {
        "xs": 36,
        "sm": 44,
        "md": 48,
        "lg": 52
      },
      "paddingX": 32,
      "weight": "medium",
      "textTransform": "none",
      "tracking": "0",
      "shadow": "0"
    },
    "input": {
      "radius": "md",
      "height": 40,
      "paddingX": 12,
      "background": "transparent",
      "shadow": "0"
    },
    "card": {
      "radius": "none",
      "padding": 24,
      "shadow": "0",
      "border": true,
      "background": "card"
    },
    "badge": {
      "radius": "full",
      "paddingX": 12,
      "weight": "medium",
      "textTransform": "none"
    },
    "tabs": {
      "radius": "md",
      "style": "segmented"
    },
    "accordion": {
      "dividers": true,
      "triggerWeight": "medium",
      "chevron": "rotate-180",
      "duration": "base",
      "paddingY": 24
    },
    "dialog": {
      "radius": "none",
      "shadow": "3",
      "padding": 24
    },
    "menu": {
      "radius": "none",
      "itemRadius": "none",
      "shadow": "2"
    },
    "control": {
      "radius": "xs"
    },
    "tooltip": {
      "radius": "sm"
    },
    "alert": {
      "radius": "none"
    }
  }
}
