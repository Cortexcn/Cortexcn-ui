{
  "id": "mintlify",
  "modes": {
    "light": {
      "background": "#ffffff",
      "foreground": "#0a0a0a",
      "card": "#f7f7f7",
      "card-foreground": "#0a0a0a",
      "popover": "#f7f7f7",
      "popover-foreground": "#0a0a0a",
      "primary": "#0a0a0a",
      "primary-foreground": "#ffffff",
      "secondary": "#fafafa",
      "secondary-foreground": "#0a0a0a",
      "muted": "#fafafa",
      "muted-foreground": "#5a5a5c",
      "accent": "#fafafa",
      "accent-foreground": "#0a0a0a",
      "destructive": "#d45656",
      "border": "#e5e5e5",
      "input": "#e5e5e5",
      "ring": "#0a0a0a",
      "chart-1": "#0a0a0a",
      "chart-2": "#00d4a4",
      "chart-3": "#3772cf",
      "chart-4": "#c37d0d",
      "chart-5": "#938387",
      "primary-hover": "#1c1c1c",
      "success": "#15803d",
      "warning": "#c37d0d",
      "overlay": "rgba(0, 0, 0, 0.4)"
    },
    "dark": {
      "background": "#0a0a0a",
      "foreground": "#ffffff",
      "card": "#111111",
      "card-foreground": "#ffffff",
      "popover": "#171717",
      "popover-foreground": "#ffffff",
      "primary": "#ebebeb",
      "primary-foreground": "#0a0a0a",
      "secondary": "#1e1e1e",
      "secondary-foreground": "#ffffff",
      "muted": "#1e1e1e",
      "muted-foreground": "#b3b3b3",
      "accent": "#1e1e1e",
      "accent-foreground": "#ffffff",
      "destructive": "#ea6a68",
      "border": "#1f1f1f",
      "input": "#313131",
      "ring": "#ebebeb",
      "chart-1": "#ebebeb",
      "chart-2": "#008666",
      "chart-3": "#5d9afa",
      "chart-4": "#b27000",
      "chart-5": "#938387",
      "primary-hover": "#d4d4d4",
      "success": "#50af69",
      "warning": "#ce8721",
      "overlay": "rgba(0, 0, 0, 0.6)"
    }
  },
  "typography": {
    "display": {
      "family": "Inter",
      "fallback": "Inter",
      "stack": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
    },
    "body": {
      "family": "Inter",
      "fallback": "Inter",
      "stack": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
    },
    "mono": {
      "family": "Geist Mono",
      "fallback": "Geist Mono",
      "stack": "\"Geist Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": [11, 12, 13, 14, 16, 18, 22, 28, 36, 48, 56, 72],
    "weights": {
      "regular": 400,
      "medium": 500,
      "bold": 600
    },
    "tracking": {
      "display": "-0.027em",
      "body": "0"
    },
    "lineHeight": {
      "display": 1.1,
      "body": 1.5
    }
  },
  "radius": {
    "none": "0px",
    "xs": "4px",
    "sm": "6px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "spacing": {
    "unit": 4,
    "density": "default"
  },
  "elevation": {
    "0": "none",
    "1": "rgba(0, 0, 0, 0.08) 0px 4px 12px 0px",
    "2": "rgba(0, 212, 164, 0.08) 0px 8px 24px",
    "3": "rgba(0, 0, 0, 0.12) 0px 24px 48px -8px"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "components": {
    "button": {
      "radius": "full",
      "height": {
        "xs": 26,
        "sm": 34,
        "md": 38,
        "lg": 42
      },
      "paddingX": 20,
      "weight": "medium",
      "textTransform": "none",
      "tracking": "0",
      "shadow": "0"
    },
    "input": {
      "radius": "md",
      "height": 40,
      "paddingX": 12,
      "background": "transparent",
      "shadow": "0"
    },
    "card": {
      "radius": "lg",
      "padding": 24,
      "shadow": "0",
      "border": true,
      "background": "background"
    },
    "badge": {
      "radius": "full",
      "paddingX": 8,
      "weight": "bold",
      "textTransform": "none"
    },
    "tabs": {
      "radius": "md",
      "style": "segmented"
    },
    "accordion": {
      "dividers": true,
      "triggerWeight": "medium",
      "chevron": "rotate-180",
      "duration": "base",
      "paddingY": 16
    },
    "dialog": {
      "radius": "lg",
      "shadow": "3",
      "padding": 24
    },
    "menu": {
      "radius": "md",
      "itemRadius": "sm",
      "shadow": "2"
    },
    "control": {
      "radius": "xs"
    },
    "tooltip": {
      "radius": "sm"
    },
    "alert": {
      "radius": "lg"
    }
  }
}
