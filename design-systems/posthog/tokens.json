{
  "id": "posthog",
  "modes": {
    "light": {
      "background": "#eeefe9",
      "foreground": "#23251d",
      "card": "#ffffff",
      "card-foreground": "#23251d",
      "popover": "#ffffff",
      "popover-foreground": "#23251d",
      "primary": "#f7a501",
      "primary-foreground": "#23251d",
      "secondary": "#e5e7e0",
      "secondary-foreground": "#23251d",
      "muted": "#e5e7e0",
      "muted-foreground": "#4d4f46",
      "accent": "#e5e7e0",
      "accent-foreground": "#23251d",
      "destructive": "#cd4239",
      "border": "#bfc1b7",
      "input": "#bfc1b7",
      "ring": "rgba(59,130,246,0.5)",
      "chart-1": "#f7a501",
      "chart-2": "#1d4ed8",
      "chart-3": "#1078a3",
      "chart-4": "#cd4239",
      "chart-5": "#2c8c66",
      "primary-hover": "#b17816",
      "success": "#2c8c66",
      "warning": "#b45309",
      "overlay": "rgba(0, 0, 0, 0.4)"
    },
    "dark": {
      "background": "#23251d",
      "foreground": "#ffffff",
      "card": "#2c2e25",
      "card-foreground": "#ffffff",
      "popover": "#32342b",
      "popover-foreground": "#ffffff",
      "primary": "#f7a501",
      "primary-foreground": "#23251d",
      "secondary": "#393c33",
      "secondary-foreground": "#ffffff",
      "muted": "#393c33",
      "muted-foreground": "#a4a69c",
      "accent": "#393c33",
      "accent-foreground": "#ffffff",
      "destructive": "#f26458",
      "border": "#44463d",
      "input": "#4f5148",
      "ring": "#f7a501",
      "chart-1": "#f7a501",
      "chart-2": "#8bb0ff",
      "chart-3": "#54adda",
      "chart-4": "#ef6256",
      "chart-5": "#50ac84",
      "primary-hover": "#da9100",
      "success": "#51ad85",
      "warning": "#de793d",
      "overlay": "rgba(0, 0, 0, 0.6)"
    }
  },
  "typography": {
    "display": {
      "family": "IBM Plex Sans Variable",
      "fallback": "IBM Plex Sans",
      "stack": "\"IBM Plex Sans\", ui-sans-serif, system-ui, sans-serif"
    },
    "body": {
      "family": "IBM Plex Sans Variable",
      "fallback": "IBM Plex Sans",
      "stack": "\"IBM Plex Sans\", ui-sans-serif, system-ui, sans-serif"
    },
    "mono": {
      "family": "Source Code Pro",
      "fallback": "Source Code Pro",
      "stack": "\"Source Code Pro\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": [12, 13, 14, 15, 16, 18, 20, 21, 24, 36],
    "weights": {
      "regular": 400,
      "medium": 700,
      "bold": 700
    },
    "tracking": {
      "display": "0",
      "body": "0"
    },
    "lineHeight": {
      "display": 1.5,
      "body": 1.5
    }
  },
  "radius": {
    "none": "0px",
    "xs": "2px",
    "sm": "4px",
    "md": "6px",
    "lg": "8px",
    "xl": "11px",
    "full": "9999px"
  },
  "spacing": {
    "unit": 2,
    "density": "default"
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px 0 rgba(0, 0, 0, 0.06)",
    "2": "0 4px 12px -2px rgba(0, 0, 0, 0.12)",
    "3": "0 16px 32px -8px rgba(0, 0, 0, 0.24)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "components": {
    "button": {
      "radius": "md",
      "height": {
        "xs": 28,
        "sm": 36,
        "md": 40,
        "lg": 44
      },
      "paddingX": 16,
      "weight": "medium",
      "textTransform": "none",
      "tracking": "0",
      "shadow": "0"
    },
    "input": {
      "radius": "md",
      "height": 36,
      "paddingX": 12,
      "background": "card",
      "shadow": "0"
    },
    "card": {
      "radius": "md",
      "padding": 24,
      "shadow": "0",
      "border": false,
      "background": "card"
    },
    "badge": {
      "radius": "none",
      "paddingX": 8,
      "weight": "medium",
      "textTransform": "uppercase"
    },
    "tabs": {
      "radius": "md",
      "style": "segmented"
    },
    "accordion": {
      "dividers": true,
      "triggerWeight": "medium",
      "chevron": "rotate-180",
      "duration": "base",
      "paddingY": 16
    },
    "dialog": {
      "radius": "md",
      "shadow": "3",
      "padding": 24
    },
    "menu": {
      "radius": "sm",
      "itemRadius": "xs",
      "shadow": "2"
    },
    "control": {
      "radius": "xs"
    },
    "tooltip": {
      "radius": "sm"
    },
    "alert": {
      "radius": "md"
    }
  }
}
