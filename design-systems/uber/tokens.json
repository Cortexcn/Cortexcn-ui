{
  "id": "uber",
  "modes": {
    "light": {
      "background": "#ffffff",
      "foreground": "#000000",
      "card": "#ffffff",
      "card-foreground": "#000000",
      "popover": "#ffffff",
      "popover-foreground": "#000000",
      "primary": "#000000",
      "primary-foreground": "#ffffff",
      "secondary": "#efefef",
      "secondary-foreground": "#000000",
      "muted": "#efefef",
      "muted-foreground": "#5e5e5e",
      "accent": "#efefef",
      "accent-foreground": "#000000",
      "destructive": "#d92d20",
      "border": "#4b4b4b",
      "input": "#4b4b4b",
      "ring": "#000000",
      "chart-1": "#000000",
      "chart-2": "#0000ee",
      "chart-3": "#271b1f",
      "chart-4": "#46393d",
      "chart-5": "#68595d",
      "primary-hover": "#020202",
      "success": "#15803d",
      "warning": "#b45309",
      "overlay": "rgba(0, 0, 0, 0.4)"
    },
    "dark": {
      "background": "#0f0f0f",
      "foreground": "#ffffff",
      "card": "#171717",
      "card-foreground": "#ffffff",
      "popover": "#1c1c1c",
      "popover-foreground": "#ffffff",
      "primary": "#ebebeb",
      "primary-foreground": "#0f0f0f",
      "secondary": "#242424",
      "secondary-foreground": "#ffffff",
      "muted": "#242424",
      "muted-foreground": "#a4a4a4",
      "accent": "#242424",
      "accent-foreground": "#ffffff",
      "destructive": "#ff5543",
      "border": "#2d2d2d",
      "input": "#373737",
      "ring": "#ebebeb",
      "chart-1": "#ebebeb",
      "chart-2": "#a7c4ff",
      "chart-3": "#dac9ce",
      "chart-4": "#d9c9ce",
      "chart-5": "#c0afb4",
      "primary-hover": "#d4d4d4",
      "success": "#50af69",
      "warning": "#de793d",
      "overlay": "rgba(0, 0, 0, 0.6)"
    }
  },
  "typography": {
    "display": {
      "family": "UberMove",
      "fallback": "Inter",
      "stack": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
    },
    "body": {
      "family": "UberMoveText",
      "fallback": "Inter",
      "stack": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
    },
    "mono": {
      "family": "JetBrains Mono",
      "fallback": "JetBrains Mono",
      "stack": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": [12, 14, 16, 18, 20, 24, 32, 36, 52],
    "weights": {
      "regular": 400,
      "medium": 500,
      "bold": 700
    },
    "tracking": {
      "display": "0",
      "body": "0"
    },
    "lineHeight": {
      "display": 1.23,
      "body": 1.5
    }
  },
  "radius": {
    "none": "0px",
    "xs": "3px",
    "sm": "6px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "spacing": {
    "unit": 2,
    "density": "default"
  },
  "elevation": {
    "0": "none",
    "1": "rgba(0, 0, 0, 0.16) 0px 2px 8px 0px",
    "2": "rgba(0, 0, 0, 0.12) 0px 4px 16px 0px",
    "3": "rgba(0, 0, 0, 0.16) 0px 4px 16px 0px"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "components": {
    "button": {
      "radius": "full",
      "height": {
        "xs": 24,
        "sm": 32,
        "md": 36,
        "lg": 40
      },
      "paddingX": 16,
      "weight": "medium",
      "textTransform": "none",
      "tracking": "0",
      "shadow": "0"
    },
    "input": {
      "radius": "none",
      "height": 40,
      "paddingX": 12,
      "background": "muted",
      "shadow": "0"
    },
    "card": {
      "radius": "xl",
      "padding": 24,
      "shadow": "0",
      "border": true,
      "background": "card"
    },
    "badge": {
      "radius": "full",
      "paddingX": 8,
      "weight": "medium",
      "textTransform": "none"
    },
    "tabs": {
      "radius": "xl",
      "style": "segmented"
    },
    "accordion": {
      "dividers": true,
      "triggerWeight": "medium",
      "chevron": "rotate-180",
      "duration": "base",
      "paddingY": 0
    },
    "dialog": {
      "radius": "xl",
      "shadow": "3",
      "padding": 24
    },
    "menu": {
      "radius": "lg",
      "itemRadius": "md",
      "shadow": "2"
    },
    "control": {
      "radius": "xs"
    },
    "tooltip": {
      "radius": "sm"
    },
    "alert": {
      "radius": "xl"
    }
  }
}
