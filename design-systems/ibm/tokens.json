{
  "id": "ibm",
  "modes": {
    "light": {
      "background": "#ffffff",
      "foreground": "#161616",
      "card": "#f4f4f4",
      "card-foreground": "#161616",
      "popover": "#e0e0e0",
      "popover-foreground": "#161616",
      "primary": "#0f62fe",
      "primary-foreground": "#ffffff",
      "secondary": "#f4f4f4",
      "secondary-foreground": "#161616",
      "muted": "#f4f4f4",
      "muted-foreground": "#525252",
      "accent": "#e0e0e0",
      "accent-foreground": "#161616",
      "destructive": "#da1e28",
      "border": "#e0e0e0",
      "input": "#161616",
      "ring": "#0f62fe",
      "chart-1": "#0f62fe",
      "chart-2": "#24a148",
      "chart-3": "#f1c21b",
      "chart-4": "#da1e28",
      "chart-5": "#00246f",
      "primary-hover": "#0050e6",
      "success": "#24a148",
      "warning": "#f1c21b",
      "overlay": "rgba(0, 0, 0, 0.4)"
    },
    "dark": {
      "background": "#161616",
      "foreground": "#ffffff",
      "card": "#262626",
      "card-foreground": "#ffffff",
      "popover": "#242424",
      "popover-foreground": "#ffffff",
      "primary": "#0f62fe",
      "primary-foreground": "#ffffff",
      "secondary": "#2b2b2b",
      "secondary-foreground": "#ffffff",
      "muted": "#2b2b2b",
      "muted-foreground": "#c6c6c6",
      "accent": "#2b2b2b",
      "accent-foreground": "#ffffff",
      "destructive": "#ff544f",
      "border": "#353535",
      "input": "#404040",
      "ring": "#0f62fe",
      "chart-1": "#0f62fe",
      "chart-2": "#26a249",
      "chart-3": "#8b6e00",
      "chart-4": "#ff5450",
      "chart-5": "#b3cfff",
      "primary-hover": "#004edb",
      "success": "#3cb359",
      "warning": "#f1c21b",
      "overlay": "rgba(0, 0, 0, 0.6)"
    }
  },
  "typography": {
    "display": {
      "family": "IBM Plex Sans",
      "fallback": "IBM Plex Sans",
      "stack": "\"IBM Plex Sans\", ui-sans-serif, system-ui, sans-serif"
    },
    "body": {
      "family": "IBM Plex Sans",
      "fallback": "IBM Plex Sans",
      "stack": "\"IBM Plex Sans\", ui-sans-serif, system-ui, sans-serif"
    },
    "mono": {
      "family": "IBM Plex Mono",
      "fallback": "IBM Plex Mono",
      "stack": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": [12, 14, 16, 18, 20, 24, 32, 42, 60, 76],
    "weights": {
      "regular": 400,
      "medium": 400,
      "bold": 300
    },
    "tracking": {
      "display": "-0.007em",
      "body": "0.01em"
    },
    "lineHeight": {
      "display": 1.17,
      "body": 1.5
    }
  },
  "radius": {
    "none": "0px",
    "xs": "2px",
    "sm": "4px",
    "md": "6px",
    "lg": "8px",
    "xl": "11px",
    "full": "9999px"
  },
  "spacing": {
    "unit": 4,
    "density": "default"
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px 0 rgba(0, 0, 0, 0.06)",
    "2": "0 4px 12px -2px rgba(0, 0, 0, 0.12)",
    "3": "0 16px 32px -8px rgba(0, 0, 0, 0.24)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "components": {
    "button": {
      "radius": "none",
      "height": {
        "xs": 30,
        "sm": 38,
        "md": 42,
        "lg": 46
      },
      "paddingX": 16,
      "weight": "regular",
      "textTransform": "none",
      "tracking": "0.011em",
      "shadow": "0"
    },
    "input": {
      "radius": "none",
      "height": 46,
      "paddingX": 16,
      "background": "card",
      "shadow": "0"
    },
    "card": {
      "radius": "none",
      "padding": 24,
      "shadow": "0",
      "border": true,
      "background": "background"
    },
    "badge": {
      "radius": "full",
      "paddingX": 8,
      "weight": "medium",
      "textTransform": "none"
    },
    "tabs": {
      "radius": "none",
      "style": "segmented"
    },
    "accordion": {
      "dividers": true,
      "triggerWeight": "medium",
      "chevron": "rotate-180",
      "duration": "base",
      "paddingY": 16
    },
    "dialog": {
      "radius": "none",
      "shadow": "3",
      "padding": 24
    },
    "menu": {
      "radius": "none",
      "itemRadius": "none",
      "shadow": "2"
    },
    "control": {
      "radius": "xs"
    },
    "tooltip": {
      "radius": "sm"
    },
    "alert": {
      "radius": "none"
    }
  }
}
