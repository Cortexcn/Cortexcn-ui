{
  "id": "figma",
  "modes": {
    "light": {
      "background": "#ffffff",
      "foreground": "#000000",
      "card": "#ffffff",
      "card-foreground": "#000000",
      "popover": "#ffffff",
      "popover-foreground": "#000000",
      "primary": "#000000",
      "primary-foreground": "#ffffff",
      "secondary": "#f7f7f5",
      "secondary-foreground": "#000000",
      "muted": "#f7f7f5",
      "muted-foreground": "#2e2e2e",
      "accent": "#f7f7f5",
      "accent-foreground": "#000000",
      "destructive": "#d92d20",
      "border": "#e6e6e6",
      "input": "#e6e6e6",
      "ring": "#000000",
      "chart-1": "#000000",
      "chart-2": "#dceeb1",
      "chart-3": "#c5b0f4",
      "chart-4": "#1ea64a",
      "chart-5": "#68595d",
      "primary-hover": "#020202",
      "success": "#1ea64a",
      "warning": "#b45309",
      "overlay": "rgba(0, 0, 0, 0.6)"
    },
    "dark": {
      "background": "#000000",
      "foreground": "#ffffff",
      "card": "#0e0e0e",
      "card-foreground": "#ffffff",
      "popover": "#141414",
      "popover-foreground": "#ffffff",
      "primary": "#ebebeb",
      "primary-foreground": "#000000",
      "secondary": "#1b1b1b",
      "secondary-foreground": "#ffffff",
      "muted": "#1b1b1b",
      "muted-foreground": "#ffffff",
      "accent": "#1b1b1b",
      "accent-foreground": "#ffffff",
      "destructive": "#ff5543",
      "border": "#242424",
      "input": "#2e2e2e",
      "ring": "#ebebeb",
      "chart-1": "#ebebeb",
      "chart-2": "#6a7941",
      "chart-3": "#7964a3",
      "chart-4": "#0d9f43",
      "chart-5": "#c0afb4",
      "primary-hover": "#d4d4d4",
      "success": "#34b457",
      "warning": "#de793d",
      "overlay": "rgba(0, 0, 0, 0.6)"
    }
  },
  "typography": {
    "display": {
      "family": "figmaSans",
      "fallback": "Inter",
      "stack": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
    },
    "body": {
      "family": "figmaSans",
      "fallback": "Inter",
      "stack": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
    },
    "mono": {
      "family": "JetBrains Mono",
      "fallback": "JetBrains Mono",
      "stack": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": [12, 16, 18, 20, 24, 26, 64, 86],
    "weights": {
      "regular": 320,
      "medium": 480,
      "bold": 340
    },
    "tracking": {
      "display": "-0.02em",
      "body": "-0.014em"
    },
    "lineHeight": {
      "display": 1,
      "body": 1.45
    }
  },
  "radius": {
    "none": "0px",
    "xs": "2px",
    "sm": "6px",
    "md": "8px",
    "lg": "24px",
    "xl": "32px",
    "full": "9999px"
  },
  "spacing": {
    "unit": 4,
    "density": "comfortable"
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px 0 rgba(0, 0, 0, 0.06)",
    "2": "0 4px 12px -2px rgba(0, 0, 0, 0.12)",
    "3": "0 16px 32px -8px rgba(0, 0, 0, 0.24)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "components": {
    "button": {
      "radius": "full",
      "height": {
        "xs": 36,
        "sm": 44,
        "md": 48,
        "lg": 52
      },
      "paddingX": 20,
      "weight": "medium",
      "textTransform": "none",
      "tracking": "-0.005em",
      "shadow": "0"
    },
    "input": {
      "radius": "md",
      "height": 50,
      "paddingX": 14,
      "background": "transparent",
      "shadow": "0"
    },
    "card": {
      "radius": "md",
      "padding": 16,
      "shadow": "0",
      "border": true,
      "background": "muted"
    },
    "badge": {
      "radius": "full",
      "paddingX": 8,
      "weight": "medium",
      "textTransform": "none"
    },
    "tabs": {
      "radius": "full",
      "style": "segmented"
    },
    "accordion": {
      "dividers": true,
      "triggerWeight": "medium",
      "chevron": "rotate-180",
      "duration": "base",
      "paddingY": 16
    },
    "dialog": {
      "radius": "md",
      "shadow": "3",
      "padding": 24
    },
    "menu": {
      "radius": "sm",
      "itemRadius": "xs",
      "shadow": "2"
    },
    "control": {
      "radius": "xs"
    },
    "tooltip": {
      "radius": "sm"
    },
    "alert": {
      "radius": "md"
    }
  }
}
