{
  "id": "wired",
  "modes": {
    "light": {
      "background": "#ffffff",
      "foreground": "#000000",
      "card": "#ffffff",
      "card-foreground": "#000000",
      "popover": "#ffffff",
      "popover-foreground": "#000000",
      "primary": "#000000",
      "primary-foreground": "#ffffff",
      "secondary": "#f5f5f5",
      "secondary-foreground": "#000000",
      "muted": "#f5f5f5",
      "muted-foreground": "#757575",
      "accent": "#f5f5f5",
      "accent-foreground": "#000000",
      "destructive": "#d92d20",
      "border": "#e0e0e0",
      "input": "#e0e0e0",
      "ring": "#000000",
      "chart-1": "#000000",
      "chart-2": "#057dbc",
      "chart-3": "#271b1f",
      "chart-4": "#46393d",
      "chart-5": "#68595d",
      "primary-hover": "#020202",
      "success": "#15803d",
      "warning": "#b45309",
      "overlay": "rgba(0, 0, 0, 0.4)"
    },
    "dark": {
      "background": "#0f0f0f",
      "foreground": "#f2f2f2",
      "card": "#171717",
      "card-foreground": "#f2f2f2",
      "popover": "#1c1c1c",
      "popover-foreground": "#f2f2f2",
      "primary": "#ebebeb",
      "primary-foreground": "#0f0f0f",
      "secondary": "#242424",
      "secondary-foreground": "#f2f2f2",
      "muted": "#242424",
      "muted-foreground": "#a4a4a4",
      "accent": "#242424",
      "accent-foreground": "#f2f2f2",
      "destructive": "#ff5543",
      "border": "#2d2d2d",
      "input": "#373737",
      "ring": "#ebebeb",
      "chart-1": "#ebebeb",
      "chart-2": "#40a2e4",
      "chart-3": "#dac9ce",
      "chart-4": "#d9c9ce",
      "chart-5": "#c0afb4",
      "primary-hover": "#d4d4d4",
      "success": "#50af69",
      "warning": "#de793d",
      "overlay": "rgba(0, 0, 0, 0.6)"
    }
  },
  "typography": {
    "display": {
      "family": "WiredDisplay",
      "fallback": "Playfair Display",
      "stack": "\"Playfair Display\", ui-serif, Georgia, serif"
    },
    "body": {
      "family": "Apercu",
      "fallback": "Inter",
      "stack": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
    },
    "mono": {
      "family": "JetBrains Mono",
      "fallback": "JetBrains Mono",
      "stack": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": [12, 12.73, 14, 16, 17, 19, 20, 26, 32, 48, 64],
    "weights": {
      "regular": 400,
      "medium": 700,
      "bold": 400
    },
    "tracking": {
      "display": "-0.008em",
      "body": "0"
    },
    "lineHeight": {
      "display": 0.93,
      "body": 1.18
    }
  },
  "radius": {
    "none": "0px",
    "xs": "0px",
    "sm": "0px",
    "md": "0px",
    "lg": "0px",
    "xl": "0px",
    "full": "9999px"
  },
  "spacing": {
    "unit": 2,
    "density": "default"
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px 0 rgba(0, 0, 0, 0.06)",
    "2": "0 4px 12px -2px rgba(0, 0, 0, 0.12)",
    "3": "0 16px 32px -8px rgba(0, 0, 0, 0.24)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "components": {
    "button": {
      "radius": "none",
      "height": {
        "xs": 24,
        "sm": 32,
        "md": 36,
        "lg": 40
      },
      "paddingX": 16,
      "weight": "medium",
      "textTransform": "none",
      "tracking": "0.019em",
      "shadow": "0"
    },
    "input": {
      "radius": "none",
      "height": 36,
      "paddingX": 12,
      "background": "transparent",
      "shadow": "0"
    },
    "card": {
      "radius": "lg",
      "padding": 24,
      "shadow": "0",
      "border": true,
      "background": "card"
    },
    "badge": {
      "radius": "none",
      "paddingX": 8,
      "weight": "medium",
      "textTransform": "none"
    },
    "tabs": {
      "radius": "md",
      "style": "segmented"
    },
    "accordion": {
      "dividers": true,
      "triggerWeight": "medium",
      "chevron": "rotate-180",
      "duration": "base",
      "paddingY": 16
    },
    "dialog": {
      "radius": "none",
      "shadow": "3",
      "padding": 24
    },
    "menu": {
      "radius": "md",
      "itemRadius": "sm",
      "shadow": "2"
    },
    "control": {
      "radius": "none"
    },
    "tooltip": {
      "radius": "none"
    },
    "alert": {
      "radius": "lg"
    }
  }
}
