{
  "id": "mongodb",
  "modes": {
    "light": {
      "background": "#ffffff",
      "foreground": "#001e2b",
      "card": "#f9fbfa",
      "card-foreground": "#001e2b",
      "popover": "#f9fbfa",
      "popover-foreground": "#001e2b",
      "primary": "#00ed64",
      "primary-foreground": "#001e2b",
      "secondary": "#f4f7f6",
      "secondary-foreground": "#001e2b",
      "muted": "#f4f7f6",
      "muted-foreground": "#5c6c7a",
      "accent": "#f4f7f6",
      "accent-foreground": "#001e2b",
      "destructive": "#d92d20",
      "border": "#e1e5e8",
      "input": "#c1ccd6",
      "ring": "#00ab46",
      "chart-1": "#00ed64",
      "chart-2": "#003d4f",
      "chart-3": "#7b3ff2",
      "chart-4": "#fa6e39",
      "chart-5": "#f06bb8",
      "primary-hover": "#008c34",
      "success": "#15803d",
      "warning": "#b45309",
      "overlay": "rgba(0, 0, 0, 0.4)"
    },
    "dark": {
      "background": "#001e2b",
      "foreground": "#ffffff",
      "card": "#072734",
      "card-foreground": "#ffffff",
      "popover": "#0e2d3a",
      "popover-foreground": "#ffffff",
      "primary": "#00ed64",
      "primary-foreground": "#001e2b",
      "secondary": "#163442",
      "secondary-foreground": "#ffffff",
      "muted": "#163442",
      "muted-foreground": "#a8b3bc",
      "accent": "#163442",
      "accent-foreground": "#ffffff",
      "destructive": "#ff5543",
      "border": "#1c2d38",
      "input": "#2b4a58",
      "ring": "#00ed64",
      "chart-1": "#00ed64",
      "chart-2": "#a1d7ed",
      "chart-3": "#a187ff",
      "chart-4": "#c04100",
      "chart-5": "#b83686",
      "primary-hover": "#00d358",
      "success": "#50af69",
      "warning": "#de793d",
      "overlay": "rgba(0, 0, 0, 0.6)"
    }
  },
  "typography": {
    "display": {
      "family": "Euclid Circular A",
      "fallback": "Outfit",
      "stack": "\"Outfit\", ui-sans-serif, system-ui, sans-serif"
    },
    "body": {
      "family": "Euclid Circular A",
      "fallback": "Outfit",
      "stack": "\"Outfit\", ui-sans-serif, system-ui, sans-serif"
    },
    "mono": {
      "family": "Source Code Pro",
      "fallback": "Source Code Pro",
      "stack": "\"Source Code Pro\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": [11, 12, 13, 14, 16, 18, 22, 28, 36, 48, 56, 72],
    "weights": {
      "regular": 400,
      "medium": 600,
      "bold": 500
    },
    "tracking": {
      "display": "-0.018em",
      "body": "0"
    },
    "lineHeight": {
      "display": 1.15,
      "body": 1.55
    }
  },
  "radius": {
    "none": "0px",
    "xs": "4px",
    "sm": "6px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "spacing": {
    "unit": 4,
    "density": "default"
  },
  "elevation": {
    "0": "none",
    "1": "rgba(0, 30, 43, 0.08) 0px 4px 12px 0px",
    "2": "rgba(0, 30, 43, 0.12) 0px 12px 24px -4px",
    "3": "rgba(0, 30, 43, 0.16) 0px 16px 48px -8px"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "components": {
    "button": {
      "radius": "full",
      "height": {
        "xs": 26,
        "sm": 34,
        "md": 38,
        "lg": 42
      },
      "paddingX": 22,
      "weight": "medium",
      "textTransform": "none",
      "tracking": "0",
      "shadow": "0"
    },
    "input": {
      "radius": "md",
      "height": 44,
      "paddingX": 12,
      "background": "transparent",
      "shadow": "0"
    },
    "card": {
      "radius": "lg",
      "padding": 24,
      "shadow": "0",
      "border": true,
      "background": "background"
    },
    "badge": {
      "radius": "sm",
      "paddingX": 8,
      "weight": "medium",
      "textTransform": "none"
    },
    "tabs": {
      "radius": "md",
      "style": "segmented"
    },
    "accordion": {
      "dividers": true,
      "triggerWeight": "medium",
      "chevron": "rotate-180",
      "duration": "base",
      "paddingY": 16
    },
    "dialog": {
      "radius": "lg",
      "shadow": "3",
      "padding": 24
    },
    "menu": {
      "radius": "md",
      "itemRadius": "sm",
      "shadow": "2"
    },
    "control": {
      "radius": "xs"
    },
    "tooltip": {
      "radius": "sm"
    },
    "alert": {
      "radius": "lg"
    }
  }
}
