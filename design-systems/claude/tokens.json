{
  "id": "claude",
  "modes": {
    "light": {
      "background": "#faf9f5",
      "foreground": "#141413",
      "card": "#efe9de",
      "card-foreground": "#141413",
      "popover": "#efe9de",
      "popover-foreground": "#141413",
      "primary": "#cc785c",
      "primary-foreground": "#ffffff",
      "secondary": "#f5f0e8",
      "secondary-foreground": "#141413",
      "muted": "#f5f0e8",
      "muted-foreground": "#3d3d3a",
      "accent": "#f5f0e8",
      "accent-foreground": "#141413",
      "destructive": "#c64545",
      "border": "#e6dfd8",
      "input": "#e6dfd8",
      "ring": "#cc785c",
      "chart-1": "#cc785c",
      "chart-2": "#5db8a6",
      "chart-3": "#e8a55a",
      "chart-4": "#5db872",
      "chart-5": "#6f331f",
      "primary-hover": "#a9583e",
      "success": "#5db872",
      "warning": "#d4a017",
      "overlay": "rgba(0, 0, 0, 0.4)"
    },
    "dark": {
      "background": "#181715",
      "foreground": "#faf9f5",
      "card": "#252320",
      "card-foreground": "#faf9f5",
      "popover": "#262523",
      "popover-foreground": "#faf9f5",
      "primary": "#cc785c",
      "primary-foreground": "#181715",
      "secondary": "#1f1e1b",
      "secondary-foreground": "#faf9f5",
      "muted": "#1f1e1b",
      "muted-foreground": "#a09d96",
      "accent": "#1f1e1b",
      "accent-foreground": "#faf9f5",
      "destructive": "#ed6865",
      "border": "#383634",
      "input": "#42413f",
      "ring": "#cc785c",
      "chart-1": "#cc785c",
      "chart-2": "#1f8373",
      "chart-3": "#9f6100",
      "chart-4": "#278643",
      "chart-5": "#ffbba5",
      "primary-hover": "#b56348",
      "success": "#5db872",
      "warning": "#d4a017",
      "overlay": "rgba(0, 0, 0, 0.6)"
    }
  },
  "typography": {
    "display": {
      "family": "Copernicus",
      "fallback": "Cormorant Garamond",
      "stack": "\"Cormorant Garamond\", ui-serif, Georgia, serif"
    },
    "body": {
      "family": "StyreneB",
      "fallback": "Inter",
      "stack": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
    },
    "mono": {
      "family": "JetBrains Mono",
      "fallback": "JetBrains Mono",
      "stack": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": [12, 13, 14, 16, 18, 22, 28, 36, 48, 64],
    "weights": {
      "regular": 400,
      "medium": 500,
      "bold": 400
    },
    "tracking": {
      "display": "-0.023em",
      "body": "0"
    },
    "lineHeight": {
      "display": 1.05,
      "body": 1.55
    }
  },
  "radius": {
    "none": "0px",
    "xs": "4px",
    "sm": "6px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "spacing": {
    "unit": 4,
    "density": "default"
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 3px rgba(20,20,19,0.08)",
    "2": "0 4px 12px -2px rgba(0, 0, 0, 0.12)",
    "3": "0 16px 32px -8px rgba(0, 0, 0, 0.24)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "components": {
    "button": {
      "radius": "md",
      "height": {
        "xs": 28,
        "sm": 36,
        "md": 40,
        "lg": 44
      },
      "paddingX": 20,
      "weight": "medium",
      "textTransform": "none",
      "tracking": "0",
      "shadow": "0"
    },
    "input": {
      "radius": "md",
      "height": 40,
      "paddingX": 14,
      "background": "transparent",
      "shadow": "0"
    },
    "card": {
      "radius": "lg",
      "padding": 32,
      "shadow": "0",
      "border": false,
      "background": "card"
    },
    "badge": {
      "radius": "full",
      "paddingX": 12,
      "weight": "medium",
      "textTransform": "none"
    },
    "tabs": {
      "radius": "md",
      "style": "segmented"
    },
    "accordion": {
      "dividers": true,
      "triggerWeight": "medium",
      "chevron": "rotate-180",
      "duration": "base",
      "paddingY": 16
    },
    "dialog": {
      "radius": "lg",
      "shadow": "3",
      "padding": 24
    },
    "menu": {
      "radius": "md",
      "itemRadius": "sm",
      "shadow": "2"
    },
    "control": {
      "radius": "xs"
    },
    "tooltip": {
      "radius": "sm"
    },
    "alert": {
      "radius": "lg"
    }
  }
}
