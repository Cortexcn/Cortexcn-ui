{
  "id": "wise",
  "modes": {
    "light": {
      "background": "#ffffff",
      "foreground": "#0e0f0c",
      "card": "#ffffff",
      "card-foreground": "#0e0f0c",
      "popover": "#ffffff",
      "popover-foreground": "#0e0f0c",
      "primary": "#9fe870",
      "primary-foreground": "#0e0f0c",
      "secondary": "#e8ebe6",
      "secondary-foreground": "#0e0f0c",
      "muted": "#e8ebe6",
      "muted-foreground": "#454745",
      "accent": "#e8ebe6",
      "accent-foreground": "#0e0f0c",
      "destructive": "#d03238",
      "border": "#dedede",
      "input": "#dedede",
      "ring": "#5ea426",
      "chart-1": "#9fe870",
      "chart-2": "#ffd11a",
      "chart-3": "#d03238",
      "chart-4": "#ffc091",
      "chart-5": "#38c8ff",
      "primary-hover": "#cdffad",
      "success": "#2ead4b",
      "warning": "#ffd11a",
      "overlay": "rgba(0, 0, 0, 0.4)"
    },
    "dark": {
      "background": "#0f0f0f",
      "foreground": "#f1f2ee",
      "card": "#171717",
      "card-foreground": "#f1f2ee",
      "popover": "#1c1c1c",
      "popover-foreground": "#f1f2ee",
      "primary": "#9fe870",
      "primary-foreground": "#0e0f0c",
      "secondary": "#242424",
      "secondary-foreground": "#f1f2ee",
      "muted": "#242424",
      "muted-foreground": "#a3a5a3",
      "accent": "#242424",
      "accent-foreground": "#f1f2ee",
      "destructive": "#f95b5a",
      "border": "#2d2d2d",
      "input": "#373737",
      "ring": "#9fe870",
      "chart-1": "#9fe870",
      "chart-2": "#896f00",
      "chart-3": "#fa5c5b",
      "chart-4": "#9b6235",
      "chart-5": "#007da4",
      "primary-hover": "#89d159",
      "success": "#37b452",
      "warning": "#ffd11a",
      "overlay": "rgba(0, 0, 0, 0.6)"
    }
  },
  "typography": {
    "display": {
      "family": "Wise Sans",
      "fallback": "Manrope",
      "stack": "\"Manrope\", ui-sans-serif, system-ui, sans-serif"
    },
    "body": {
      "family": "Inter",
      "fallback": "Inter",
      "stack": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
    },
    "mono": {
      "family": "JetBrains Mono",
      "fallback": "JetBrains Mono",
      "stack": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": [12, 14, 16, 20, 24, 32, 40, 47, 64, 96, 126],
    "weights": {
      "regular": 400,
      "medium": 600,
      "bold": 900
    },
    "tracking": {
      "display": "0",
      "body": "0"
    },
    "lineHeight": {
      "display": 0.85,
      "body": 1.5
    }
  },
  "radius": {
    "none": "0px",
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "full": "9999px"
  },
  "spacing": {
    "unit": 2,
    "density": "default"
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px 0 rgba(0, 0, 0, 0.06)",
    "2": "0 4px 12px -2px rgba(0, 0, 0, 0.12)",
    "3": "0 16px 32px -8px rgba(0, 0, 0, 0.24)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "components": {
    "button": {
      "radius": "xl",
      "height": {
        "xs": 28,
        "sm": 36,
        "md": 40,
        "lg": 44
      },
      "paddingX": 16,
      "weight": "medium",
      "textTransform": "none",
      "tracking": "0",
      "shadow": "0"
    },
    "input": {
      "radius": "md",
      "height": 40,
      "paddingX": 12,
      "background": "transparent",
      "shadow": "0"
    },
    "card": {
      "radius": "xl",
      "padding": 24,
      "shadow": "0",
      "border": true,
      "background": "card"
    },
    "badge": {
      "radius": "full",
      "paddingX": 8,
      "weight": "medium",
      "textTransform": "none"
    },
    "tabs": {
      "radius": "md",
      "style": "segmented"
    },
    "accordion": {
      "dividers": true,
      "triggerWeight": "medium",
      "chevron": "rotate-180",
      "duration": "base",
      "paddingY": 16
    },
    "dialog": {
      "radius": "xl",
      "shadow": "3",
      "padding": 24
    },
    "menu": {
      "radius": "lg",
      "itemRadius": "md",
      "shadow": "2"
    },
    "control": {
      "radius": "xs"
    },
    "tooltip": {
      "radius": "sm"
    },
    "alert": {
      "radius": "xl"
    }
  }
}
