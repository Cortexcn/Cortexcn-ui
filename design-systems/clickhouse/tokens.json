{
  "id": "clickhouse",
  "modes": {
    "light": {
      "background": "#fafafa",
      "foreground": "#121212",
      "card": "#ffffff",
      "card-foreground": "#121212",
      "popover": "#ffffff",
      "popover-foreground": "#121212",
      "primary": "#faff69",
      "primary-foreground": "#0a0a0a",
      "secondary": "#f0f0f0",
      "secondary-foreground": "#121212",
      "muted": "#f0f0f0",
      "muted-foreground": "#5b5b5b",
      "accent": "#f0f0f0",
      "accent-foreground": "#121212",
      "destructive": "#cf1e29",
      "border": "#dfdfdf",
      "input": "#d2d2d2",
      "ring": "#939600",
      "chart-1": "#faff69",
      "chart-2": "#006028",
      "chart-3": "#c2011d",
      "chart-4": "#1b63d5",
      "chart-5": "#5e3900",
      "primary-hover": "#e3e74e",
      "success": "#00893c",
      "warning": "#9d6300",
      "overlay": "rgba(0, 0, 0, 0.4)"
    },
    "dark": {
      "background": "#0a0a0a",
      "foreground": "#ffffff",
      "card": "#1a1a1a",
      "card-foreground": "#ffffff",
      "popover": "#242424",
      "popover-foreground": "#ffffff",
      "primary": "#faff69",
      "primary-foreground": "#0a0a0a",
      "secondary": "#121212",
      "secondary-foreground": "#ffffff",
      "muted": "#121212",
      "muted-foreground": "#cccccc",
      "accent": "#121212",
      "accent-foreground": "#ffffff",
      "destructive": "#ef4444",
      "border": "#2a2a2a",
      "input": "#3a3a3a",
      "ring": "#faff69",
      "chart-1": "#faff69",
      "chart-2": "#22c55e",
      "chart-3": "#ef4444",
      "chart-4": "#3b82f6",
      "chart-5": "#f59e0b",
      "primary-hover": "#e6eb52",
      "success": "#22c55e",
      "warning": "#f59e0b",
      "overlay": "rgba(0, 0, 0, 0.6)"
    }
  },
  "typography": {
    "display": {
      "family": "Inter",
      "fallback": "Inter",
      "stack": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
    },
    "body": {
      "family": "Inter",
      "fallback": "Inter",
      "stack": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
    },
    "mono": {
      "family": "JetBrains Mono",
      "fallback": "JetBrains Mono",
      "stack": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": [12, 13, 14, 16, 18, 24, 32, 40, 56, 72],
    "weights": {
      "regular": 400,
      "medium": 600,
      "bold": 700
    },
    "tracking": {
      "display": "-0.035em",
      "body": "0"
    },
    "lineHeight": {
      "display": 1.05,
      "body": 1.55
    }
  },
  "radius": {
    "none": "0px",
    "xs": "4px",
    "sm": "6px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "spacing": {
    "unit": 4,
    "density": "default"
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px 0 rgba(0, 0, 0, 0.06)",
    "2": "0 4px 12px -2px rgba(0, 0, 0, 0.12)",
    "3": "0 16px 32px -8px rgba(0, 0, 0, 0.24)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "components": {
    "button": {
      "radius": "md",
      "height": {
        "xs": 28,
        "sm": 36,
        "md": 40,
        "lg": 44
      },
      "paddingX": 20,
      "weight": "medium",
      "textTransform": "none",
      "tracking": "0",
      "shadow": "0"
    },
    "input": {
      "radius": "md",
      "height": 40,
      "paddingX": 14,
      "background": "card",
      "shadow": "0"
    },
    "card": {
      "radius": "lg",
      "padding": 32,
      "shadow": "0",
      "border": false,
      "background": "card"
    },
    "badge": {
      "radius": "full",
      "paddingX": 12,
      "weight": "regular",
      "textTransform": "none"
    },
    "tabs": {
      "radius": "md",
      "style": "segmented"
    },
    "accordion": {
      "dividers": true,
      "triggerWeight": "medium",
      "chevron": "rotate-180",
      "duration": "base",
      "paddingY": 16
    },
    "dialog": {
      "radius": "lg",
      "shadow": "3",
      "padding": 24
    },
    "menu": {
      "radius": "md",
      "itemRadius": "sm",
      "shadow": "2"
    },
    "control": {
      "radius": "xs"
    },
    "tooltip": {
      "radius": "sm"
    },
    "alert": {
      "radius": "lg"
    }
  }
}
