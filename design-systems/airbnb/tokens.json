{
  "id": "airbnb",
  "modes": {
    "light": {
      "background": "#ffffff",
      "foreground": "#222222",
      "card": "#ffffff",
      "card-foreground": "#222222",
      "popover": "#ffffff",
      "popover-foreground": "#222222",
      "primary": "#ff385c",
      "primary-foreground": "#ffffff",
      "secondary": "#f7f7f7",
      "secondary-foreground": "#222222",
      "muted": "#f7f7f7",
      "muted-foreground": "#3f3f3f",
      "accent": "#f2f2f2",
      "accent-foreground": "#222222",
      "destructive": "#c13515",
      "border": "#dddddd",
      "input": "#c1c1c1",
      "ring": "#ff385c",
      "chart-1": "#ff385c",
      "chart-2": "#ff9da2",
      "chart-3": "#bb2340",
      "chart-4": "#ffd9da",
      "chart-5": "#880026",
      "primary-hover": "#e00b41",
      "success": "#15803d",
      "warning": "#b45309",
      "overlay": "rgba(0, 0, 0, 0.6)"
    },
    "dark": {
      "background": "#0f0f0f",
      "foreground": "#ffffff",
      "card": "#171717",
      "card-foreground": "#ffffff",
      "popover": "#1c1c1c",
      "popover-foreground": "#ffffff",
      "primary": "#ff385c",
      "primary-foreground": "#0f0f0f",
      "secondary": "#242424",
      "secondary-foreground": "#ffffff",
      "muted": "#242424",
      "muted-foreground": "#a4a4a4",
      "accent": "#242424",
      "accent-foreground": "#ffffff",
      "destructive": "#f36546",
      "border": "#2d2d2d",
      "input": "#373737",
      "ring": "#ff385c",
      "chart-1": "#ff385c",
      "chart-2": "#ab5259",
      "chart-3": "#ff7782",
      "chart-4": "#896869",
      "chart-5": "#ffb8ba",
      "primary-hover": "#e50e48",
      "success": "#50af69",
      "warning": "#de793d",
      "overlay": "rgba(0, 0, 0, 0.6)"
    }
  },
  "typography": {
    "display": {
      "family": "Airbnb Cereal VF",
      "fallback": "Inter",
      "stack": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
    },
    "body": {
      "family": "Airbnb Cereal VF",
      "fallback": "Inter",
      "stack": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
    },
    "mono": {
      "family": "JetBrains Mono",
      "fallback": "JetBrains Mono",
      "stack": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": [8, 11, 12, 13, 14, 16, 20, 21, 22, 28, 64],
    "weights": {
      "regular": 400,
      "medium": 500,
      "bold": 700
    },
    "tracking": {
      "display": "0",
      "body": "0"
    },
    "lineHeight": {
      "display": 1.43,
      "body": 1.5
    }
  },
  "radius": {
    "none": "0px",
    "xs": "4px",
    "sm": "8px",
    "md": "14px",
    "lg": "20px",
    "xl": "32px",
    "full": "9999px"
  },
  "spacing": {
    "unit": 2,
    "density": "comfortable"
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px 0 rgba(0, 0, 0, 0.06)",
    "2": "0 4px 12px -2px rgba(0, 0, 0, 0.12)",
    "3": "0 16px 32px -8px rgba(0, 0, 0, 0.24)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "components": {
    "button": {
      "radius": "sm",
      "height": {
        "xs": 36,
        "sm": 44,
        "md": 48,
        "lg": 52
      },
      "paddingX": 24,
      "weight": "medium",
      "textTransform": "none",
      "tracking": "0",
      "shadow": "0"
    },
    "input": {
      "radius": "sm",
      "height": 56,
      "paddingX": 12,
      "background": "transparent",
      "shadow": "0"
    },
    "card": {
      "radius": "md",
      "padding": 24,
      "shadow": "0",
      "border": true,
      "background": "card"
    },
    "badge": {
      "radius": "full",
      "paddingX": 6,
      "weight": "bold",
      "textTransform": "uppercase"
    },
    "tabs": {
      "radius": "md",
      "style": "segmented"
    },
    "accordion": {
      "dividers": true,
      "triggerWeight": "medium",
      "chevron": "rotate-180",
      "duration": "base",
      "paddingY": 16
    },
    "dialog": {
      "radius": "md",
      "shadow": "3",
      "padding": 24
    },
    "menu": {
      "radius": "sm",
      "itemRadius": "xs",
      "shadow": "2"
    },
    "control": {
      "radius": "xs"
    },
    "tooltip": {
      "radius": "sm"
    },
    "alert": {
      "radius": "md"
    }
  }
}
