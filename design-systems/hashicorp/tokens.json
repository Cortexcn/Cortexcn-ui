{
  "id": "hashicorp",
  "modes": {
    "light": {
      "background": "#ffffff",
      "foreground": "#000000",
      "card": "#ffffff",
      "card-foreground": "#000000",
      "popover": "#ffffff",
      "popover-foreground": "#000000",
      "primary": "#161616",
      "primary-foreground": "#ffffff",
      "secondary": "#f5f5f5",
      "secondary-foreground": "#000000",
      "muted": "#f5f5f5",
      "muted-foreground": "#575b61",
      "accent": "#f5f5f5",
      "accent-foreground": "#000000",
      "destructive": "#d50b04",
      "border": "#e4e4e4",
      "input": "#d7d7d7",
      "ring": "#161616",
      "chart-1": "#161616",
      "chart-2": "#0062c9",
      "chart-3": "#a16ae7",
      "chart-4": "#483800",
      "chart-5": "#d50e05",
      "primary-hover": "#292929",
      "success": "#00865d",
      "warning": "#8a6e00",
      "overlay": "rgba(0, 0, 0, 0.4)"
    },
    "dark": {
      "background": "#000000",
      "foreground": "#ffffff",
      "card": "#15181e",
      "card-foreground": "#ffffff",
      "popover": "#1f232b",
      "popover-foreground": "#ffffff",
      "primary": "#ffffff",
      "primary-foreground": "#000000",
      "secondary": "#15181e",
      "secondary-foreground": "#ffffff",
      "muted": "#15181e",
      "muted-foreground": "#b2b6bd",
      "accent": "#1f232b",
      "accent-foreground": "#ffffff",
      "destructive": "#e62b1e",
      "border": "#3b3d45",
      "input": "#3b3d45",
      "ring": "#ffffff",
      "chart-1": "#ffffff",
      "chart-2": "#2b89ff",
      "chart-3": "#7b42bc",
      "chart-4": "#ffcf25",
      "chart-5": "#e62b1e",
      "primary-hover": "#e8e8e8",
      "success": "#00ca8e",
      "warning": "#ffcf25",
      "overlay": "rgba(0, 0, 0, 0.6)"
    }
  },
  "typography": {
    "display": {
      "family": "hashicorpSans",
      "fallback": "Inter",
      "stack": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
    },
    "body": {
      "family": "hashicorpSans",
      "fallback": "Inter",
      "stack": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
    },
    "mono": {
      "family": "JetBrains Mono",
      "fallback": "JetBrains Mono",
      "stack": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": [12, 13, 14, 16, 18, 20, 22, 28, 40, 56, 80],
    "weights": {
      "regular": 500,
      "medium": 600,
      "bold": 700
    },
    "tracking": {
      "display": "-0.031em",
      "body": "0"
    },
    "lineHeight": {
      "display": 1.17,
      "body": 1.5
    }
  },
  "radius": {
    "none": "0px",
    "xs": "4px",
    "sm": "6px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "spacing": {
    "unit": 4,
    "density": "default"
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px 0 rgba(0, 0, 0, 0.06)",
    "2": "0 4px 12px -2px rgba(0, 0, 0, 0.12)",
    "3": "0 16px 32px -8px rgba(0, 0, 0, 0.24)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "components": {
    "button": {
      "radius": "md",
      "height": {
        "xs": 26,
        "sm": 34,
        "md": 38,
        "lg": 42
      },
      "paddingX": 18,
      "weight": "medium",
      "textTransform": "none",
      "tracking": "0",
      "shadow": "0"
    },
    "input": {
      "radius": "md",
      "height": 44,
      "paddingX": 14,
      "background": "card",
      "shadow": "0"
    },
    "card": {
      "radius": "lg",
      "padding": 24,
      "shadow": "0",
      "border": false,
      "background": "card"
    },
    "badge": {
      "radius": "full",
      "paddingX": 8,
      "weight": "medium",
      "textTransform": "none"
    },
    "tabs": {
      "radius": "md",
      "style": "segmented"
    },
    "accordion": {
      "dividers": true,
      "triggerWeight": "medium",
      "chevron": "rotate-180",
      "duration": "base",
      "paddingY": 16
    },
    "dialog": {
      "radius": "lg",
      "shadow": "3",
      "padding": 24
    },
    "menu": {
      "radius": "md",
      "itemRadius": "sm",
      "shadow": "2"
    },
    "control": {
      "radius": "xs"
    },
    "tooltip": {
      "radius": "sm"
    },
    "alert": {
      "radius": "lg"
    }
  }
}
