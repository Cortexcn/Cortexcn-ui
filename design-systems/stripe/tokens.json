{
  "id": "stripe",
  "modes": {
    "light": {
      "background": "#ffffff",
      "foreground": "#0d253d",
      "card": "#ffffff",
      "card-foreground": "#0d253d",
      "popover": "#ffffff",
      "popover-foreground": "#0d253d",
      "primary": "#533afd",
      "primary-foreground": "#ffffff",
      "secondary": "#f6f9fc",
      "secondary-foreground": "#0d253d",
      "muted": "#f6f9fc",
      "muted-foreground": "#273951",
      "accent": "#f6f9fc",
      "accent-foreground": "#0d253d",
      "destructive": "#ea2261",
      "border": "#e3e8ee",
      "input": "#a8c3de",
      "ring": "#533afd",
      "chart-1": "#533afd",
      "chart-2": "#7a82ff",
      "chart-3": "#3418b0",
      "chart-4": "#a6b1ff",
      "chart-5": "#1c006f",
      "primary-hover": "#2e2b8c",
      "success": "#15803d",
      "warning": "#9b6829",
      "overlay": "rgba(0, 0, 0, 0.4)"
    },
    "dark": {
      "background": "#0f0f0f",
      "foreground": "#e8f3ff",
      "card": "#171717",
      "card-foreground": "#e8f3ff",
      "popover": "#1c1c1c",
      "popover-foreground": "#e8f3ff",
      "primary": "#533afd",
      "primary-foreground": "#ffffff",
      "secondary": "#242424",
      "secondary-foreground": "#e8f3ff",
      "muted": "#242424",
      "muted-foreground": "#99a6b8",
      "accent": "#242424",
      "accent-foreground": "#e8f3ff",
      "destructive": "#ff4c78",
      "border": "#2d2d2d",
      "input": "#373737",
      "ring": "#533afd",
      "chart-1": "#533afd",
      "chart-2": "#666be6",
      "chart-3": "#c1caff",
      "chart-4": "#626ab2",
      "chart-5": "#c1caff",
      "primary-hover": "#4513e4",
      "success": "#50af69",
      "warning": "#c18c4f",
      "overlay": "rgba(0, 0, 0, 0.6)"
    }
  },
  "typography": {
    "display": {
      "family": "sohne-var",
      "fallback": "Inter",
      "stack": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
    },
    "body": {
      "family": "sohne-var",
      "fallback": "Inter",
      "stack": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
    },
    "mono": {
      "family": "JetBrains Mono",
      "fallback": "JetBrains Mono",
      "stack": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": [10, 11, 13, 14, 15, 16, 18, 20, 22, 26, 32, 48, 56],
    "weights": {
      "regular": 300,
      "medium": 400,
      "bold": 300
    },
    "tracking": {
      "display": "-0.025em",
      "body": "0"
    },
    "lineHeight": {
      "display": 1.03,
      "body": 1.4
    }
  },
  "radius": {
    "none": "0px",
    "xs": "4px",
    "sm": "6px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "spacing": {
    "unit": 2,
    "density": "compact"
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px 0 rgba(0, 0, 0, 0.06)",
    "2": "0 4px 12px -2px rgba(0, 0, 0, 0.12)",
    "3": "0 16px 32px -8px rgba(0, 0, 0, 0.24)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "components": {
    "button": {
      "radius": "full",
      "height": {
        "xs": 20,
        "sm": 28,
        "md": 32,
        "lg": 36
      },
      "paddingX": 16,
      "weight": "medium",
      "textTransform": "none",
      "tracking": "0",
      "shadow": "0"
    },
    "input": {
      "radius": "sm",
      "height": 37,
      "paddingX": 12,
      "background": "transparent",
      "shadow": "0"
    },
    "card": {
      "radius": "lg",
      "padding": 32,
      "shadow": "0",
      "border": true,
      "background": "card"
    },
    "badge": {
      "radius": "full",
      "paddingX": 8,
      "weight": "medium",
      "textTransform": "none"
    },
    "tabs": {
      "radius": "md",
      "style": "segmented"
    },
    "accordion": {
      "dividers": true,
      "triggerWeight": "medium",
      "chevron": "rotate-180",
      "duration": "base",
      "paddingY": 16
    },
    "dialog": {
      "radius": "lg",
      "shadow": "3",
      "padding": 24
    },
    "menu": {
      "radius": "md",
      "itemRadius": "sm",
      "shadow": "2"
    },
    "control": {
      "radius": "xs"
    },
    "tooltip": {
      "radius": "sm"
    },
    "alert": {
      "radius": "lg"
    }
  }
}
