{
  "id": "warp",
  "modes": {
    "light": {
      "background": "#fff9f4",
      "foreground": "#13110e",
      "card": "#ffffff",
      "card-foreground": "#13110e",
      "popover": "#ffffff",
      "popover-foreground": "#13110e",
      "primary": "#171612",
      "primary-foreground": "#fff9f4",
      "secondary": "#f5efea",
      "secondary-foreground": "#13110e",
      "muted": "#f5efea",
      "muted-foreground": "#625a49",
      "accent": "#f5efea",
      "accent-foreground": "#13110e",
      "destructive": "#c13c37",
      "border": "#e4deda",
      "input": "#d7d1cd",
      "ring": "#171612",
      "chart-1": "#171612",
      "chart-2": "#3f3a2f",
      "chart-3": "#524d41",
      "chart-4": "#736e62",
      "chart-5": "#979285",
      "primary-hover": "#2a2925",
      "success": "#008843",
      "warning": "#906b00",
      "overlay": "rgba(0, 0, 0, 0.4)"
    },
    "dark": {
      "background": "#2b2622",
      "foreground": "#f7f5f0",
      "card": "#2b2622",
      "card-foreground": "#f7f5f0",
      "popover": "#2b2622",
      "popover-foreground": "#f7f5f0",
      "primary": "#f7f5f0",
      "primary-foreground": "#2b2622",
      "secondary": "#383330",
      "secondary-foreground": "#f7f5f0",
      "muted": "#383330",
      "muted-foreground": "#c9c0ad",
      "accent": "#383330",
      "accent-foreground": "#f7f5f0",
      "destructive": "#f97066",
      "border": "#3f3a36",
      "input": "#3f3a36",
      "ring": "#f7f5f0",
      "chart-1": "#f7f5f0",
      "chart-2": "#d3cdbf",
      "chart-3": "#ada79a",
      "chart-4": "#888376",
      "chart-5": "#656054",
      "primary-hover": "#e0ded9",
      "success": "#4ade80",
      "warning": "#fbbf24",
      "overlay": "rgba(0, 0, 0, 0.6)"
    }
  },
  "typography": {
    "display": {
      "family": "Inter",
      "fallback": "Inter",
      "stack": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
    },
    "body": {
      "family": "Inter",
      "fallback": "Inter",
      "stack": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
    },
    "mono": {
      "family": "DM Mono",
      "fallback": "DM Mono",
      "stack": "\"DM Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": [12, 13, 14, 16, 18, 24, 32, 48, 64],
    "weights": {
      "regular": 400,
      "medium": 500,
      "bold": 400
    },
    "tracking": {
      "display": "-0.025em",
      "body": "0"
    },
    "lineHeight": {
      "display": 1.1,
      "body": 1.5
    }
  },
  "radius": {
    "none": "0px",
    "xs": "2px",
    "sm": "3px",
    "md": "4px",
    "lg": "6px",
    "xl": "8px",
    "full": "9999px"
  },
  "spacing": {
    "unit": 2,
    "density": "default"
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px 0 rgba(0, 0, 0, 0.06)",
    "2": "0 4px 12px -2px rgba(0, 0, 0, 0.12)",
    "3": "0 16px 32px -8px rgba(0, 0, 0, 0.24)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "components": {
    "button": {
      "radius": "sm",
      "height": {
        "xs": 24,
        "sm": 32,
        "md": 36,
        "lg": 40
      },
      "paddingX": 16,
      "weight": "medium",
      "textTransform": "none",
      "tracking": "0",
      "shadow": "0"
    },
    "input": {
      "radius": "sm",
      "height": 36,
      "paddingX": 12,
      "background": "muted",
      "shadow": "0"
    },
    "card": {
      "radius": "md",
      "padding": 24,
      "shadow": "0",
      "border": true,
      "background": "muted"
    },
    "badge": {
      "radius": "full",
      "paddingX": 8,
      "weight": "medium",
      "textTransform": "none"
    },
    "tabs": {
      "radius": "md",
      "style": "segmented"
    },
    "accordion": {
      "dividers": true,
      "triggerWeight": "medium",
      "chevron": "rotate-180",
      "duration": "base",
      "paddingY": 16
    },
    "dialog": {
      "radius": "lg",
      "shadow": "3",
      "padding": 24
    },
    "menu": {
      "radius": "sm",
      "itemRadius": "xs",
      "shadow": "2"
    },
    "control": {
      "radius": "xs"
    },
    "tooltip": {
      "radius": "sm"
    },
    "alert": {
      "radius": "md"
    }
  }
}
