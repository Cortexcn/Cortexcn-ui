{
  "id": "vercel",
  "modes": {
    "light": {
      "background": "#fafafa",
      "foreground": "#171717",
      "card": "#ffffff",
      "card-foreground": "#171717",
      "popover": "#ffffff",
      "popover-foreground": "#171717",
      "primary": "#171717",
      "primary-foreground": "#ffffff",
      "secondary": "#e6e6e6",
      "secondary-foreground": "#171717",
      "muted": "#e6e6e6",
      "muted-foreground": "#4d4d4d",
      "accent": "#e6e6e6",
      "accent-foreground": "#171717",
      "destructive": "#ee0000",
      "border": "#ebebeb",
      "input": "#ebebeb",
      "ring": "#171717",
      "chart-1": "#171717",
      "chart-2": "#0070f3",
      "chart-3": "#ee0000",
      "chart-4": "#f5a623",
      "chart-5": "#00dfd8",
      "primary-hover": "#2a2a2a",
      "success": "#15803d",
      "warning": "#f5a623",
      "overlay": "rgba(0, 0, 0, 0.4)"
    },
    "dark": {
      "background": "#0f0f0f",
      "foreground": "#f2f2f2",
      "card": "#171717",
      "card-foreground": "#f2f2f2",
      "popover": "#1c1c1c",
      "popover-foreground": "#f2f2f2",
      "primary": "#ebebeb",
      "primary-foreground": "#0f0f0f",
      "secondary": "#242424",
      "secondary-foreground": "#f2f2f2",
      "muted": "#242424",
      "muted-foreground": "#a4a4a4",
      "accent": "#242424",
      "accent-foreground": "#f2f2f2",
      "destructive": "#ff5544",
      "border": "#2d2d2d",
      "input": "#373737",
      "ring": "#ebebeb",
      "chart-1": "#ebebeb",
      "chart-2": "#4f96ff",
      "chart-3": "#ff3b2d",
      "chart-4": "#9a6500",
      "chart-5": "#00837e",
      "primary-hover": "#d4d4d4",
      "success": "#50af69",
      "warning": "#f5a623",
      "overlay": "rgba(0, 0, 0, 0.6)"
    }
  },
  "typography": {
    "display": {
      "family": "Geist",
      "fallback": "Geist",
      "stack": "\"Geist\", ui-sans-serif, system-ui, sans-serif"
    },
    "body": {
      "family": "Geist",
      "fallback": "Geist",
      "stack": "\"Geist\", ui-sans-serif, system-ui, sans-serif"
    },
    "mono": {
      "family": "Geist Mono",
      "fallback": "Geist Mono",
      "stack": "\"Geist Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": [12, 14, 16, 20, 32, 48],
    "weights": {
      "regular": 400,
      "medium": 500,
      "bold": 600
    },
    "tracking": {
      "display": "-0.05em",
      "body": "0"
    },
    "lineHeight": {
      "display": 1,
      "body": 1.43
    }
  },
  "radius": {
    "none": "0px",
    "xs": "3px",
    "sm": "6px",
    "md": "12px",
    "lg": "16px",
    "xl": "21px",
    "full": "9999px"
  },
  "spacing": {
    "unit": 4,
    "density": "compact"
  },
  "elevation": {
    "0": "none",
    "1": "0px 1px 1px rgba(0,0,0,0.04)",
    "2": "0 4px 12px -2px rgba(0, 0, 0, 0.12)",
    "3": "0 16px 32px -8px rgba(0, 0, 0, 0.24)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "components": {
    "button": {
      "radius": "full",
      "height": {
        "xs": 20,
        "sm": 24,
        "md": 28,
        "lg": 32
      },
      "paddingX": 14,
      "weight": "medium",
      "textTransform": "none",
      "tracking": "0",
      "shadow": "0"
    },
    "input": {
      "radius": "sm",
      "height": 36,
      "paddingX": 12,
      "background": "card",
      "shadow": "0"
    },
    "card": {
      "radius": "md",
      "padding": 24,
      "shadow": "0",
      "border": true,
      "background": "card"
    },
    "badge": {
      "radius": "full",
      "paddingX": 8,
      "weight": "medium",
      "textTransform": "none"
    },
    "tabs": {
      "radius": "md",
      "style": "segmented"
    },
    "accordion": {
      "dividers": true,
      "triggerWeight": "medium",
      "chevron": "rotate-180",
      "duration": "base",
      "paddingY": 16
    },
    "dialog": {
      "radius": "md",
      "shadow": "3",
      "padding": 24
    },
    "menu": {
      "radius": "sm",
      "itemRadius": "xs",
      "shadow": "2"
    },
    "control": {
      "radius": "xs"
    },
    "tooltip": {
      "radius": "sm"
    },
    "alert": {
      "radius": "md"
    }
  }
}
