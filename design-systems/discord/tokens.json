{
  "id": "discord",
  "modes": {
    "light": {
      "background": "#f8faff",
      "foreground": "#000000",
      "card": "#ffffff",
      "card-foreground": "#000000",
      "popover": "#ffffff",
      "popover-foreground": "#000000",
      "primary": "#5865f2",
      "primary-foreground": "#ffffff",
      "secondary": "#eef0f5",
      "secondary-foreground": "#000000",
      "muted": "#eef0f5",
      "muted-foreground": "#333333",
      "accent": "#eef0f5",
      "accent-foreground": "#000000",
      "destructive": "#c13c37",
      "border": "#dedfe4",
      "input": "#d0d2d7",
      "ring": "#5865f2",
      "chart-1": "#5865f2",
      "chart-2": "#00587d",
      "chart-3": "#8699ff",
      "chart-4": "#2e3664",
      "chart-5": "#899cff",
      "primary-hover": "#474eda",
      "success": "#008941",
      "warning": "#906b00",
      "overlay": "rgba(0, 0, 0, 0.4)"
    },
    "dark": {
      "background": "#0a0d3a",
      "foreground": "#ffffff",
      "card": "#1e2353",
      "card-foreground": "#ffffff",
      "popover": "#1e2353",
      "popover-foreground": "#ffffff",
      "primary": "#5865f2",
      "primary-foreground": "#ffffff",
      "secondary": "#161d4b",
      "secondary-foreground": "#ffffff",
      "muted": "#161d4b",
      "muted-foreground": "#aeaeae",
      "accent": "#161d4b",
      "accent-foreground": "#ffffff",
      "destructive": "#f97066",
      "border": "#23272a",
      "input": "#23272a",
      "ring": "#5865f2",
      "chart-1": "#5865f2",
      "chart-2": "#00b0f4",
      "chart-3": "#3941ac",
      "chart-4": "#b9c7ff",
      "chart-5": "#201a84",
      "primary-hover": "#474eda",
      "success": "#35ed7e",
      "warning": "#fbbf24",
      "overlay": "rgba(0, 0, 0, 0.6)"
    }
  },
  "typography": {
    "display": {
      "family": "ABC Ginto Nord",
      "fallback": "Unbounded",
      "stack": "\"Unbounded\", ui-sans-serif, system-ui, sans-serif"
    },
    "body": {
      "family": "ggsans",
      "fallback": "Figtree",
      "stack": "\"Figtree\", ui-sans-serif, system-ui, sans-serif"
    },
    "mono": {
      "family": "JetBrains Mono",
      "fallback": "JetBrains Mono",
      "stack": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": [14, 16, 18, 20, 22, 48, 56, 62, 82],
    "weights": {
      "regular": 400,
      "medium": 500,
      "bold": 800
    },
    "tracking": {
      "display": "0",
      "body": "0"
    },
    "lineHeight": {
      "display": 1,
      "body": 1.5
    }
  },
  "radius": {
    "none": "0px",
    "xs": "6px",
    "sm": "12px",
    "md": "14px",
    "lg": "16px",
    "xl": "40px",
    "full": "9999px"
  },
  "spacing": {
    "unit": 4,
    "density": "default"
  },
  "elevation": {
    "0": "none",
    "1": "0 3px 68px rgba(69,42,124,0.1)",
    "2": "0 4px 12px -2px rgba(0, 0, 0, 0.12)",
    "3": "0 16px 32px -8px rgba(0, 0, 0, 0.24)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "components": {
    "button": {
      "radius": "sm",
      "height": {
        "xs": 29,
        "sm": 37,
        "md": 41,
        "lg": 45
      },
      "paddingX": 16,
      "weight": "medium",
      "textTransform": "none",
      "tracking": "0",
      "shadow": "0"
    },
    "input": {
      "radius": "md",
      "height": 40,
      "paddingX": 12,
      "background": "transparent",
      "shadow": "0"
    },
    "card": {
      "radius": "xl",
      "padding": 24,
      "shadow": "0",
      "border": false,
      "background": "card"
    },
    "badge": {
      "radius": "lg",
      "paddingX": 8,
      "weight": "medium",
      "textTransform": "none"
    },
    "tabs": {
      "radius": "lg",
      "style": "segmented"
    },
    "accordion": {
      "dividers": true,
      "triggerWeight": "medium",
      "chevron": "rotate-180",
      "duration": "base",
      "paddingY": 16
    },
    "dialog": {
      "radius": "lg",
      "shadow": "3",
      "padding": 24
    },
    "menu": {
      "radius": "lg",
      "itemRadius": "md",
      "shadow": "2"
    },
    "control": {
      "radius": "xs"
    },
    "tooltip": {
      "radius": "sm"
    },
    "alert": {
      "radius": "xl"
    }
  }
}
