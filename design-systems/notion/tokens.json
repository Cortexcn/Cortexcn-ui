{
  "id": "notion",
  "modes": {
    "light": {
      "background": "#ffffff",
      "foreground": "#000000",
      "card": "#ffffff",
      "card-foreground": "#000000",
      "popover": "#ffffff",
      "popover-foreground": "#000000",
      "primary": "#0075de",
      "primary-foreground": "#ffffff",
      "secondary": "#f6f5f4",
      "secondary-foreground": "#000000",
      "muted": "#f6f5f4",
      "muted-foreground": "#615d59",
      "accent": "#f6f5f4",
      "accent-foreground": "#000000",
      "destructive": "#d92d20",
      "border": "#e6e6e6",
      "input": "#e6e6e6",
      "ring": "#0075de",
      "chart-1": "#0075de",
      "chart-2": "#d6b6f6",
      "chart-3": "#ff64c8",
      "chart-4": "#dd5b00",
      "chart-5": "#2a9d99",
      "primary-hover": "#005bab",
      "success": "#1aae39",
      "warning": "#b45309",
      "overlay": "rgba(0, 0, 0, 0.4)"
    },
    "dark": {
      "background": "#0f0f0f",
      "foreground": "#f2f2f2",
      "card": "#171717",
      "card-foreground": "#f2f2f2",
      "popover": "#1c1c1c",
      "popover-foreground": "#f2f2f2",
      "primary": "#0075de",
      "primary-foreground": "#ffffff",
      "secondary": "#242424",
      "secondary-foreground": "#f2f2f2",
      "muted": "#242424",
      "muted-foreground": "#a8a49f",
      "accent": "#242424",
      "accent-foreground": "#f2f2f2",
      "destructive": "#ff5543",
      "border": "#2d2d2d",
      "input": "#373737",
      "ring": "#0075de",
      "chart-1": "#0075de",
      "chart-2": "#80629c",
      "chart-3": "#bf218f",
      "chart-4": "#d95900",
      "chart-5": "#219894",
      "primary-hover": "#0061ba",
      "success": "#29b641",
      "warning": "#de793d",
      "overlay": "rgba(0, 0, 0, 0.6)"
    }
  },
  "typography": {
    "display": {
      "family": "NotionInter",
      "fallback": "Inter",
      "stack": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
    },
    "body": {
      "family": "NotionInter",
      "fallback": "Inter",
      "stack": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
    },
    "mono": {
      "family": "JetBrains Mono",
      "fallback": "JetBrains Mono",
      "stack": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": [12, 14, 15, 16, 20, 22, 26, 40, 54, 64],
    "weights": {
      "regular": 400,
      "medium": 500,
      "bold": 700
    },
    "tracking": {
      "display": "-0.033em",
      "body": "0"
    },
    "lineHeight": {
      "display": 1,
      "body": 1.5
    }
  },
  "radius": {
    "none": "0px",
    "xs": "4px",
    "sm": "5px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "spacing": {
    "unit": 4,
    "density": "default"
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px 0 rgba(0, 0, 0, 0.06)",
    "2": "0 4px 12px -2px rgba(0, 0, 0, 0.12)",
    "3": "0 16px 32px -8px rgba(0, 0, 0, 0.24)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "components": {
    "button": {
      "radius": "full",
      "height": {
        "xs": 28,
        "sm": 36,
        "md": 40,
        "lg": 44
      },
      "paddingX": 16,
      "weight": "medium",
      "textTransform": "none",
      "tracking": "0",
      "shadow": "0"
    },
    "input": {
      "radius": "xs",
      "height": 32,
      "paddingX": 6,
      "background": "transparent",
      "shadow": "0"
    },
    "card": {
      "radius": "lg",
      "padding": 24,
      "shadow": "0",
      "border": true,
      "background": "card"
    },
    "badge": {
      "radius": "full",
      "paddingX": 8,
      "weight": "medium",
      "textTransform": "none"
    },
    "tabs": {
      "radius": "md",
      "style": "segmented"
    },
    "accordion": {
      "dividers": true,
      "triggerWeight": "medium",
      "chevron": "rotate-180",
      "duration": "base",
      "paddingY": 16
    },
    "dialog": {
      "radius": "xl",
      "shadow": "3",
      "padding": 24
    },
    "menu": {
      "radius": "md",
      "itemRadius": "sm",
      "shadow": "2"
    },
    "control": {
      "radius": "xs"
    },
    "tooltip": {
      "radius": "sm"
    },
    "alert": {
      "radius": "lg"
    }
  }
}
