import { readdirSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

// Scans src/registry/examples/*.tsx and emits src/registry/__index__.tsx,
// a name -> { component (lazy), file } map consumed by <ComponentPreview>.

const __dirname = dirname(fileURLToPath(import.meta.url));
const registryDir = join(__dirname, "..", "registry");
const examplesDir = join(registryDir, "examples");

const examples = readdirSync(examplesDir)
  .filter((file) => file.endsWith(".tsx"))
  .map((file) => file.replace(/\.tsx$/, ""))
  .sort();

const entries = examples
  .map((name) => {
    const importPath = `@/registry/examples/${name}`;
    const filePath = `src/registry/examples/${name}.tsx`;
    return `  "${name}": {
    component: React.lazy(() => import("${importPath}")),
    file: "${filePath}",
  },`;
  })
  .join("\n");

const output = `// THIS FILE IS GENERATED BY \`pnpm build:index\` — DO NOT EDIT.
import * as React from "react";

export const Index: Record<
  string,
  { component: React.LazyExoticComponent<React.ComponentType>; file: string }
> = {
${entries}
};
`;

writeFileSync(join(registryDir, "__index__.tsx"), output, "utf-8");
console.log(`[registry] generated __index__.tsx with ${examples.length} example(s)`);
