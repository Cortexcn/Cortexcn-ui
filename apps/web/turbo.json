{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/templates/**",
        "!$TURBO_ROOT$/templates/*/node_modules/**",
        "!$TURBO_ROOT$/templates/*/.next/**"
      ]
    }
  }
}
