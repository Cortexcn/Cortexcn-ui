# Central Icon System license (https://www.npmjs.com/package/@central-icons-react/all)
CENTRAL_LICENSE_KEY=

# OpenPanel analytics (https://openpanel.dev)
OPENPANEL_CLIENT_ID=
OPENPANEL_CLIENT_SECRET=

# Search engine verification (the content value of the meta tag each console gives you)
# Google Search Console: https://search.google.com/search-console
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools: https://www.bing.com/webmasters
BING_SITE_VERIFICATION=

# Cloudflare Web Analytics beacon token (Web Analytics > Add a site > cortexcn.dev)
# Powers the Cortexcn tab of the Insights section on syedmoinuddin.com.
NEXT_PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# Contact form (app/api/contact/route.ts); see apps/cortexcn/checklist.md
# Cloudflare Turnstile widget keys (Cloudflare dashboard > Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Resend (https://resend.com); the from address must be on a verified domain
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
# Optional, defaults to studio@cortexcn.dev
CONTACT_TO_EMAIL=
