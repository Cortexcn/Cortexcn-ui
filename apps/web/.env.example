# Central Icon System license (https://www.npmjs.com/package/@central-icons-react/all)
CENTRAL_LICENSE_KEY=

# OpenPanel analytics (https://openpanel.dev)
OPENPANEL_CLIENT_ID=
OPENPANEL_CLIENT_SECRET=

# Search engine verification (the content value of the meta tag each console gives you)
# Google Search Console: https://search.google.com/search-console
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools: https://www.bing.com/webmasters
BING_SITE_VERIFICATION=

# Cloudflare Web Analytics beacon token (Web Analytics > Add a site > cortexcn.dev)
# Powers the Cortexcn tab of the Insights section on syedmoinuddin.com.
NEXT_PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# Plausible (https://plausible.io): page views on every page. The site names
# as added in Plausible, comma-separated, such as
# www.cortexcn.dev,ui.cortexcn.dev. Unset, the script stays off.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Usage log: registry (/r/*.json) and MCP requests, written to the Convex
# deployment's /usage/log route and shown on /admin/stats. Set the same value
# here and on Convex (`bunx convex env set USAGE_LOG_SECRET <value>`).
# IP addresses are hashed with this secret, so changing it starts the unique
# installer counts over. Unset, nothing is logged.
USAGE_LOG_SECRET=

# Contact form (app/api/contact/route.ts); see apps/cortexcn/checklist.md
# Cloudflare Turnstile widget keys (Cloudflare dashboard > Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Resend (https://resend.com); the from address must be on a verified domain
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
# Optional, defaults to studio@cortexcn.dev
CONTACT_TO_EMAIL=

# Upstash Redis (https://upstash.com), optional. Shares the MCP and contact
# rate limits across server instances (lib/rate-limit.ts); without it each
# instance counts on its own. The Vercel Marketplace integration sets
# KV_REST_API_URL and KV_REST_API_TOKEN instead, which work too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Convex (https://convex.dev), optional: sign-in. Keep these in this .env file,
# not .env.local; `bun run dev` passes them to the Convex CLI. Without them,
# sign-in stays off. The Convex functions read BETTER_AUTH_SECRET, SITE_URL,
# GOOGLE_CLIENT_ID, and GOOGLE_CLIENT_SECRET from the Convex deployment, so set
# those there too with `bunx convex env set`.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
