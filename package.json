{
  "name": "cortexcn",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:studio-docs": "pnpm --filter studio-docs dev",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "format": "ultracite fix",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "prepare": "husky",
    "registry:build": "pnpm --filter @bklitui/ui registry:build",
    "registry:verify": "node packages/ui/scripts/verify-registry-files.mjs && node packages/ui/scripts/verify-registry-deps.mjs && node packages/ui/scripts/verify-registry-sync.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "husky": "^9.1.7",
    "next": "16.3.6",
    "prettier": "^3.9.9",
    "turbo": "^2.11.4",
    "typescript": "6.0.3",
    "ultracite": "7.0.12"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "@central-icons-react/all"
    ],
    "overrides": {
      "esm-env": "npm:esm-env-runtime@^0.1.1"
    }
  }
}
