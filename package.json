{
  "name": "cortexcn",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "format": "ultracite fix",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "prepare": "husky",
    "registry:build": "bun run --filter @cortexcn/ui registry:build",
    "registry:verify": "node packages/ui/scripts/verify-registry-files.mjs && node packages/ui/scripts/verify-registry-deps.mjs && node packages/ui/scripts/verify-registry-sync.mjs",
    "ds:ingest": "bun scripts/design-systems/ingest.ts",
    "ds:build": "bun scripts/design-systems/build.ts",
    "validate:ds": "bun scripts/validate-design-systems.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/culori": "^4.0.1",
    "culori": "^4.0.2",
    "husky": "^9.1.7",
    "next": "16.3.6",
    "prettier": "^3.9.9",
    "turbo": "^2.11.4",
    "typescript": "6.0.3",
    "ultracite": "7.0.12",
    "zod": "^4.6.5"
  },
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "esm-env": "npm:esm-env-runtime@^0.1.1"
  }
}
